{
  "v": 2,
  "name": "issue-triage",
  "schemas": {
    "Input": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "owner/name of the public repository"
        },
        "numbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "issue numbers to triage"
        },
        "label_map": {
          "type": "object",
          "description": "the maintainers' type labels mapped onto the four: bug, feature, docs, question",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "bug",
              "feature",
              "docs",
              "question"
            ]
          }
        }
      },
      "required": [
        "repo",
        "numbers",
        "label_map"
      ],
      "additionalProperties": false
    },
    "IssueRecord": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "body",
        "url"
      ]
    },
    "LinkedPrs": {
      "type": "object",
      "properties": {
        "prs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "number",
              "title",
              "state",
              "paths"
            ]
          }
        }
      },
      "required": [
        "prs"
      ]
    },
    "Research": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "What the issue asks, in two or three sentences, from what the tools returned."
        },
        "reproduces": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "not stated"
          ],
          "description": "Whether the issue gives a way to reproduce what it reports."
        },
        "code_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository paths the issue or its pull requests name, that you read."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "issue, pr <number>, or a file path you read"
              },
              "quote": {
                "type": "string",
                "description": "A short quotation, at most 200 characters, copied from that source."
              }
            },
            "required": [
              "source",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary",
        "reproduces",
        "code_paths",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "enum": [
            "bug",
            "feature",
            "docs",
            "question"
          ]
        },
        "label_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "good_first_issue": {
          "type": "boolean"
        },
        "good_first_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "quote"
            ]
          }
        },
        "maintainer_label": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "bug",
            "feature",
            "docs",
            "question"
          ]
        },
        "agrees": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "actionable": {
          "type": "boolean"
        },
        "actionable_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "label",
        "label_confidence",
        "good_first_issue",
        "good_first_confidence",
        "evidence",
        "maintainer_label",
        "agrees",
        "actionable",
        "actionable_confidence"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Row"
          }
        },
        "agreement": {
          "type": "object",
          "properties": {
            "agreed": {
              "type": "integer"
            },
            "compared": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "summary": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "agreed",
            "compared",
            "total",
            "summary",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repo",
        "rows",
        "agreement"
      ],
      "additionalProperties": false
    },
    "MaintainerLabels": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "labels"
      ]
    },
    "CodeFetched": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository paths now readable under repo/ in the workspace."
        }
      },
      "required": [
        "paths"
      ]
    },
    "Judgment": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "bug",
            "feature",
            "docs",
            "question"
          ],
          "description": "Which one type fits this issue best, going by what the issue asks for and the evidence read for it, not by who wrote it or how it is worded?",
          "criteria": {
            "bug": "The issue reports behaviour that contradicts the repository's own documentation or an earlier release, with a way to see it fail.",
            "feature": "The issue asks for behaviour the project does not have, or a change to an API on purpose; nothing is broken today.",
            "docs": "The issue is about wrong, missing or unclear documentation, a README or a guide; the code behaves as designed.",
            "question": "The reporter asks how to use the project, or why it works as it does; no change is asked for."
          }
        },
        "good_first_issue": {
          "type": "boolean",
          "description": "Is this a good first issue: could a newcomer to the project take it and finish it without a maintainer's design decision?",
          "criteria": {
            "true": "The change is small and local (one file or one function), the issue names where it is, the expected result is stated or checkable by a test, and a newcomer can do it without knowing the project's design.",
            "false": "The change spans several modules, needs a design decision from a maintainer, depends on an unreleased change or an unclear ask, or needs knowledge of the project's internals."
          }
        },
        "actionable": {
          "type": "boolean",
          "description": "Can a maintainer act on this report as written: does it give enough to start work without asking the reporter anything first?",
          "criteria": {
            "true": "The report states what is wrong or what is wanted and gives enough to start: a version or setup, a way to reproduce, or a clear ask.",
            "false": "The report is missing something a maintainer must ask for before starting: a version or setup, a way to reproduce, or what is wanted."
          }
        }
      },
      "required": [
        "label",
        "good_first_issue",
        "actionable"
      ],
      "additionalProperties": false
    }
  },
  "input": {
    "schemaId": "Input"
  },
  "output": {
    "schemaId": "Result",
    "path": "result"
  },
  "root": {
    "node": "chain",
    "steps": [
      {
        "node": "map",
        "label": "triage-each-issue",
        "itemsPath": "numbers",
        "as": "rows",
        "resultPath": "row",
        "maxConcurrency": 4,
        "body": {
          "node": "chain",
          "steps": [
            {
              "node": "call",
              "label": "read-issue",
              "via": "tool",
              "tool": "github_issue",
              "args": {
                "repo": "{repo}",
                "number": "{item}"
              },
              "out": "IssueRecord",
              "as": "issue",
              "deadline_s": 30,
              "retry": {
                "attempts": 3,
                "backoff_s": 1,
                "on": [
                  "timeout",
                  "http_5xx",
                  "http_429",
                  "connection"
                ]
              }
            },
            {
              "node": "call",
              "label": "read-linked-prs",
              "via": "tool",
              "tool": "github_linked_prs",
              "args": {
                "repo": "{repo}",
                "number": "{item}"
              },
              "out": "LinkedPrs",
              "as": "linked",
              "deadline_s": 30,
              "retry": {
                "attempts": 3,
                "backoff_s": 1,
                "on": [
                  "timeout",
                  "http_5xx",
                  "http_429",
                  "connection"
                ]
              }
            },
            {
              "node": "call",
              "label": "fetch-code",
              "via": "tool",
              "tool": "github_code",
              "args": {
                "repo": "{repo}",
                "number": "{item}"
              },
              "out": "CodeFetched",
              "as": "code",
              "deadline_s": 60,
              "retry": {
                "attempts": 3,
                "backoff_s": 1,
                "on": [
                  "timeout",
                  "http_5xx",
                  "http_429",
                  "connection"
                ]
              }
            },
            {
              "node": "agent",
              "label": "research",
              "state": {
                "issue": "{issue}",
                "linked_prs": "{linked.prs}",
                "readable_paths": "{code.paths}"
              },
              "out": "Research",
              "as": "research",
              "requires": [
                "issue.title"
              ],
              "tools": [
                "read",
                "grep",
                "find",
                "ls"
              ],
              "effort": "low",
              "instructions": "You triage one issue of a public repository. Its record is in `issue` (its number, title, body and URL) and the pull requests that mention it are in `linked_prs`. Read the code the issue or those pull requests name with the read-only tools you have (read, grep, find, ls): the files `readable_paths` lists are under `repo/` in your workspace. Report what the issue asks, whether it gives a way to reproduce what it reports, the paths you read, and at least one short quotation from each source you rely on (the issue itself, a pull request's title, a file). Quote; never paraphrase a quotation. If a path you want does not exist, say so in the summary and do not invent its contents. You decide nothing about labels here."
            },
            {
              "node": "judge",
              "label": "triage",
              "state": {
                "title": "{issue.title}",
                "body": "{issue.body}",
                "summary": "{research.summary}",
                "reproduces": "{research.reproduces}",
                "code_paths": "{research.code_paths}",
                "evidence": "{research.evidence}",
                "linked_prs": "{linked.prs}"
              },
              "out": "Judgment",
              "as": "decision"
            },
            {
              "node": "call",
              "label": "read-maintainer-labels",
              "via": "tool",
              "tool": "github_labels",
              "args": {
                "repo": "{repo}",
                "number": "{item}"
              },
              "out": "MaintainerLabels",
              "as": "maintainer",
              "deadline_s": 30,
              "retry": {
                "attempts": 3,
                "backoff_s": 1,
                "on": [
                  "timeout",
                  "http_5xx",
                  "http_429",
                  "connection"
                ]
              }
            },
            {
              "node": "code",
              "label": "row",
              "as": "row",
              "code": "(s) => { const label = s.decision.label; const mapped = (s.maintainer.labels || []).map((name) => s.label_map[name]).filter((value) => value !== undefined); const maintainer = mapped.length ? mapped[0] : null; return { number: s.issue.number, title: s.issue.title, url: s.issue.url, label, label_confidence: s['decision$answers'].answers.label.confidence, good_first_issue: s.decision.good_first_issue, good_first_confidence: Math.abs(s['decision$answers'].answers.good_first_issue.noul - 0.5) * 2, actionable: s.decision.actionable, actionable_confidence: Math.abs(s['decision$answers'].answers.actionable.noul - 0.5) * 2, evidence: s.research.evidence, maintainer_label: maintainer, agrees: maintainer === null ? null : maintainer === label }; }"
            }
          ]
        }
      },
      {
        "node": "code",
        "label": "finish",
        "code": "(s) => { const compared = s.rows.filter((row) => row.agrees !== null); const agreed = compared.filter((row) => row.agrees).length; return { result: { repo: s.repo, rows: s.rows, agreement: { agreed, compared: compared.length, total: s.rows.length, summary: 'Jev agreed with the maintainers\\' type label on ' + agreed + ' of ' + compared.length + (compared.length < s.rows.length ? ' (' + (s.rows.length - compared.length) + ' without a type label from the maintainers)' : ''), note: 'Only the maintainers\\' type labels (bug, feature, docs, question) are scored: a waiting-on-reporter state is a process, not a type, so the actionable column is shown for every issue and never scored.' } } }; }"
      }
    ]
  }
}
