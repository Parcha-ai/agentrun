{
  "id": "antigravity",
  "label": "Google Antigravity",
  "description": "Google's agy CLI as an ACP agent (agy acp), as T3 Code runs it: on a Gemini API key from Google AI Studio saved for it alone, or, on its owner's own machine alone, on their own Google sign-in, made by the agent itself with agy acp --login (agentrun harness sign-in). AgentRun never reads, refreshes or sends the sign-in (HARNESS.md#sign-in).",
  "release": {
    "version": "1.5.14",
    "archives": {
      "linux-x86_64": {
        "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/linux-x64/cli_linux_x64.tar.gz",
        "format": "tar.gz",
        "sha512": "83311d3f354567612dc16c1ae2ea9b503d6f6833aa4e138d39aa229da3f3bb99b0e4d7cca0bce4796b0060d6a51d8113eb7449ed5dc0e7900bf217107ea5bff9",
        "cmd": "./antigravity"
      },
      "linux-aarch64": {
        "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/linux-arm/cli_linux_arm64.tar.gz",
        "format": "tar.gz",
        "sha512": "c9b29bba475f63a1a80161ae93ba72b221c7a586d9851e4d0061546704bab66d6b2760b25d716d191724fc7564f3246456ee151e28aa37af48dbcd72bdc6c463",
        "cmd": "./antigravity"
      },
      "darwin-x86_64": {
        "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/darwin-x64/cli_mac_x64.tar.gz",
        "format": "tar.gz",
        "sha512": "1b6a1fc6dbe46ba6d9d0405d1b6095189f35ebfc4c3c33ceb1fd1b6d0c9fd702b52ac10b64b8b52aed0d8d71ae02c5df3cffd5e3e3d37549c2daffcce2a853c7",
        "cmd": "./antigravity"
      },
      "darwin-aarch64": {
        "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/darwin-arm/cli_mac_arm64.tar.gz",
        "format": "tar.gz",
        "sha512": "26830fd46bfb9200d073cf3e71bf94b707552557b4380ec01afd6e99f3a2b030e65422dab1867f77318078692defc859a7547d17ec4b0b1e9369f13c9c3caea6",
        "cmd": "./antigravity"
      }
    }
  },
  "args": ["acp", "--disable-telemetry"],
  "env": { "AGY_CLI_DISABLE_AUTO_UPDATE": "1", "AGY_ACP_FORCE_FILE_STORAGE": "1" },
  "model": { "billing": "plan", "maxTurns": 20, "maxToolCalls": 40, "hosts": ["cloudcode-pa.googleapis.com", "oauth2.googleapis.com", "www.googleapis.com", "generativelanguage.googleapis.com"] },
  "keys": [{ "name": "ANTIGRAVITY_GEMINI_API_KEY", "env": "GEMINI_API_KEY" }],
  "keyMethod": "gemini-api-key",
  "signIn": { "args": ["--login"], "homeArg": "--gemini-dir", "terms": "https://antigravity.google/terms" },
  "declares": { "load": true, "mcp": "http" }
}
