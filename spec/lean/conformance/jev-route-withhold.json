{
  "description": "Route withhold at confidence 0.98 takes withhold; only proceed invokes an effect.",
  "workflow": {
    "v": 2,
    "name": "jev-route-withhold",
    "schemas": {
      "Any": {
        "type": "object"
      }
    },
    "output": {
      "schemaId": "Any"
    },
    "root": {
      "node": "route",
      "label": "decision",
      "state": {
        "request": "Use the complete supplied request and policy."
      },
      "instructions": "Choose proceed, withhold, or clarify from the supplied request.",
      "as": "decision",
      "unsure": {
        "branch": "clarify",
        "gte": 0.6
      },
      "branches": {
        "proceed": {
          "criteria": "The request calls for proceed.",
          "body": {
            "node": "call",
            "label": "apply",
            "via": "tool",
            "tool": "apply_move",
            "args": {},
            "out": "Any",
            "as": "result",
            "deadline_s": 10
          }
        },
        "withhold": {
          "criteria": "The request calls for withhold.",
          "body": {
            "node": "code",
            "label": "withhold",
            "as": "result",
            "code": "() => ({\"action\":\"withhold\",\"changed\":false})"
          }
        },
        "clarify": {
          "criteria": "The request calls for clarify.",
          "body": {
            "node": "code",
            "label": "clarify",
            "as": "result",
            "code": "() => ({\"action\":\"clarify\",\"changed\":false})"
          }
        }
      }
    }
  },
  "input": {},
  "script": {
    "judge": {
      "/root": {
        "answers": {
          "branch": {
            "type": "choice",
            "choice": "withhold",
            "probabilities": {
              "proceed": 0.01,
              "withhold": 0.98,
              "clarify": 0.01
            },
            "confidence": 0.98
          }
        }
      }
    },
    "code": {
      "/root/branches/withhold/body": {
        "return": {
          "action": "withhold",
          "changed": false
        }
      }
    }
  },
  "expected": {
    "valid": true,
    "outcome": "complete",
    "state": {
      "decision": {
        "branch": "withhold",
        "taken": "withhold",
        "unsure": false
      },
      "decision$answers": {
        "answers": {
          "branch": {
            "type": "choice",
            "choice": "withhold",
            "probabilities": {
              "proceed": 0.01,
              "withhold": 0.98,
              "clarify": 0.01
            },
            "confidence": 0.98
          }
        },
        "confidence": {
          "branch": 0.98
        },
        "weakest": "branch",
        "min_confidence": 0.98
      },
      "result": {
        "action": "withhold",
        "changed": false
      }
    },
    "output": {
      "decision": {
        "branch": "withhold",
        "taken": "withhold",
        "unsure": false
      },
      "decision$answers": {
        "answers": {
          "branch": {
            "type": "choice",
            "choice": "withhold",
            "probabilities": {
              "proceed": 0.01,
              "withhold": 0.98,
              "clarify": 0.01
            },
            "confidence": 0.98
          }
        },
        "confidence": {
          "branch": 0.98
        },
        "weakest": "branch",
        "min_confidence": 0.98
      },
      "result": {
        "action": "withhold",
        "changed": false
      }
    },
    "events": {
      "/root": [
        "route.chosen:decision:withhold"
      ],
      "/root/branches/withhold/body": [
        "node.start:withhold",
        "node.end:withhold:ok"
      ]
    }
  }
}
