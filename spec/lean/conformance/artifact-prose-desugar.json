{
  "description": "A markdown artifact is sugar for the report writer (desugarWorkflow).",
  "workflow": {
    "v": 2,
    "name": "artifact",
    "schemas": {
      "Any": {
        "type": "object"
      },
      "V": {
        "type": "object",
        "properties": {
          "v": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "schemaId": "Any"
    },
    "root": {
      "node": "chain",
      "steps": [
        {
          "node": "agent",
          "label": "draft",
          "instructions": "Do it.",
          "out": "V",
          "as": "draft"
        },
        {
          "node": "artifact",
          "label": "deliver",
          "type": "markdown",
          "instructions": "Write it.",
          "requires": [
            "draft"
          ]
        }
      ]
    }
  },
  "input": {
    "q": 1
  },
  "script": {
    "gen": {
      "/root/steps/0": {
        "submission": {
          "v": "d"
        }
      },
      "/root/steps/1": {
        "markdown": "An artifact long enough to satisfy the forty-character floor."
      }
    }
  },
  "expected": {
    "valid": true,
    "outcome": "complete",
    "state": {
      "q": 1,
      "draft": {
        "v": "d"
      },
      "report_markdown": "An artifact long enough to satisfy the forty-character floor."
    },
    "output": {
      "q": 1,
      "draft": {
        "v": "d"
      },
      "report_markdown": "An artifact long enough to satisfy the forty-character floor."
    },
    "events": {
      "/root/steps/0": [
        "node.start:draft",
        "node.end:draft:ok"
      ],
      "/root/steps/1": [
        "node.start:deliver",
        "node.end:deliver:ok"
      ]
    }
  }
}
