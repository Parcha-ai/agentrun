{
  "description": "A scalar host write and an array write on the same new key conflict, in this branch order as in the other.",
  "workflow": {
    "v": 2,
    "name": "par-host-sa",
    "schemas": {
      "Any": {
        "type": "object"
      },
      "V": {
        "type": "object",
        "properties": {
          "v": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "schemaId": "Any"
    },
    "root": {
      "node": "parallel",
      "label": "both",
      "branches": [
        {
          "node": "agent",
          "label": "a",
          "instructions": "Do it.",
          "out": "V",
          "as": "a"
        },
        {
          "node": "agent",
          "label": "b",
          "instructions": "Do it.",
          "out": "V",
          "as": "b"
        }
      ]
    }
  },
  "input": {
    "q": 1
  },
  "script": {
    "gen": {
      "/root/branches/0": {
        "submission": {
          "v": "a"
        },
        "host": {
          "k": "scalar"
        }
      },
      "/root/branches/1": {
        "submission": {
          "v": "b"
        },
        "host": {
          "k": [
            "x"
          ]
        }
      }
    }
  },
  "expected": {
    "valid": true,
    "outcome": "failed",
    "error": {
      "kind": "state",
      "reason": "parallel_write_conflict",
      "label": "both",
      "path": "$host.k"
    },
    "events": {
      "/root/branches/0": [
        "node.start:a",
        "node.end:a:ok"
      ],
      "/root/branches/1": [
        "node.start:b",
        "node.end:b:ok"
      ]
    }
  }
}
