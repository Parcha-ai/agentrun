{
  "description": "A code node seeds state; an agent reads it through requires and writes under its as key.",
  "workflow": {
    "v": 2,
    "name": "chain",
    "schemas": {
      "Any": {
        "type": "object"
      },
      "V": {
        "type": "object",
        "properties": {
          "v": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "schemaId": "Any",
      "path": "answer"
    },
    "root": {
      "node": "chain",
      "steps": [
        {
          "node": "code",
          "label": "seed",
          "code": "s => ({ topic: s.question.trim() })"
        },
        {
          "node": "agent",
          "label": "answer",
          "instructions": "Do it.",
          "out": "V",
          "as": "answer",
          "requires": [
            "topic"
          ]
        }
      ]
    }
  },
  "input": {
    "question": " wiki "
  },
  "script": {
    "gen": {
      "/root/steps/1": {
        "submission": {
          "v": "yes"
        }
      }
    },
    "code": {
      "/root/steps/0": {
        "return": {
          "topic": "wiki"
        }
      }
    }
  },
  "expected": {
    "valid": true,
    "outcome": "complete",
    "state": {
      "question": " wiki ",
      "topic": "wiki",
      "answer": {
        "v": "yes"
      }
    },
    "output": {
      "v": "yes"
    },
    "events": {
      "/root/steps/0": [
        "node.start:seed",
        "node.end:seed:ok"
      ],
      "/root/steps/1": [
        "node.start:answer",
        "node.end:answer:ok"
      ]
    }
  }
}
