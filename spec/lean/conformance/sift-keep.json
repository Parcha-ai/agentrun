{
  "description": "A sift asks each item the same questions, writes every item's typed value and sidecar, and keeps the items whose keep answer meets the threshold (0.5 for a yes/no value).",
  "workflow": {
    "v": 2,
    "name": "sift-keep",
    "schemas": {
      "Any": {
        "type": "object"
      },
      "Keep": {
        "type": "object",
        "properties": {
          "keep": {
            "type": "boolean",
            "description": "Keep this item?"
          }
        }
      }
    },
    "output": {
      "schemaId": "Any",
      "path": "screened"
    },
    "root": {
      "node": "sift",
      "label": "screen",
      "itemsPath": "items",
      "out": "Keep",
      "as": "screened",
      "keep": {
        "path": "keep"
      }
    }
  },
