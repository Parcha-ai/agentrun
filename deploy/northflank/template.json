{
  "apiVersion": "v1.2",
  "name": "AgentRun Server",
  "description": "AgentRun Server from its published image: the API, the console and one runner, on one instance with a 10 GB volume at /data.",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "AgentRun",
            "description": "AgentRun Server and its data.",
            "region": "europe-west"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "SecretGroup",
                "updateMode": "create",
                "spec": {
                  "name": "agentrun-keys",
                  "description": "The API token (the first visit's setup code) and the seal key, made once. Keep the seal key: without it the saved keys can't be opened.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "AGENTRUN_TOKEN": "${fn.randomSecret(64, 'hex')}",
                      "AGENTRUN_SEAL_KEY": "${fn.randomSecret(43, 'base64')}"
                    },
                    "files": {}
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "DeploymentService",
                "ref": "agentrun",
                "spec": {
                  "name": "agentrun",
                  "description": "AgentRun Server and one runner, from the release's published image.",
                  "billing": {
                    "deploymentPlan": "nf-compute-100-2"
                  },
                  "deployment": {
                    "instances": 1,
                    "external": {
                      "imagePath": "ghcr.io/parcha-ai/agentrun-server:v0.1.0-beta.56"
                    },
                    "docker": {
                      "configType": "default"
                    },
                    "gracePeriodSeconds": 35
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 7340,
                      "public": true,
                      "protocol": "HTTP",
                      "domains": [],
                      "disableNfDomain": false,
                      "security": {
                        "credentials": [],
                        "policies": []
                      }
                    }
                  ],
                  "runtimeEnvironment": {
                    "AGENTRUN_RUN_USER": "same"
                  },
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/v2/health",
                      "port": 7340,
                      "initialDelaySeconds": 5,
                      "periodSeconds": 10,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    },
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "path": "/v2/health",
                      "port": 7340,
                      "initialDelaySeconds": 60,
                      "periodSeconds": 30,
                      "timeoutSeconds": 10,
                      "failureThreshold": 4
                    }
                  ]
                }
              },
              {
                "kind": "Volume",
                "updateMode": "create",
                "spec": {
                  "name": "agentrun-data",
                  "mounts": [
                    {
                      "containerMountPath": "/data",
                      "volumeMountPath": ""
                    }
                  ],
                  "spec": {
                    "accessMode": "ReadWriteOnce",
                    "storageClassName": "nvme",
                    "storageSize": 10240
                  },
                  "attachedObjects": [
                    {
                      "id": "${refs.agentrun.id}",
                      "type": "service"
                    }
                  ]
                }
              },
              {
                "kind": "SecretGroup",
                "spec": {
                  "name": "agentrun-address",
                  "description": "The address people open: the service's Northflank domain.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "AGENTRUN_PUBLIC_URL": "https://${refs.agentrun.ports.0.dns}"
                    },
                    "files": {}
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Service",
                  "spec": {
                    "data": {
                      "serviceId": "${refs.agentrun.id}"
                    },
                    "type": "running"
                  }
                }
              },
              {
                "kind": "Action",
                "spec": {
                  "kind": "Service",
                  "spec": {
                    "data": {
                      "serviceId": "${refs.agentrun.id}"
                    },
                    "type": "restart"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
