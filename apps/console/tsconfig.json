{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@dsl/*": ["../../packages/dsl/src/*"], "@timeline/*": ["../../packages/pi-durable-agent/src/timeline/*"], "@pi-browser/*": ["../../packages/pi-browser/src/core/*"] }
  },
  "include": ["src", ".storybook/*.ts", ".storybook/*.tsx"]
}
