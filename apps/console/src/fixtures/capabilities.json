{
  "request": {
    "method": "GET",
    "path": "/v2/capabilities"
  },
  "status": 200,
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "backend": "local",
    "contract": "agentrun.v2/0",
    "server": {
      "name": "@parcha/agentrun-serve",
      "version": "0.1.0-beta.28",
      "platform": "linux"
    },
    "runtimes": [
      "runner"
    ],
    "harnesses": [
      {
        "id": "pi",
        "available": true,
        "steer": true,
        "default_model": "faux/faux-1"
      },
      {
        "id": "claude-agent",
        "available": false,
        "steer": false,
        "reason": "claude-agent needs ANTHROPIC_API_KEY.",
        "default_model": null
      },
      {
        "id": "codex",
        "available": false,
        "steer": false,
        "reason": "codex needs OPENAI_API_KEY, or a gateway in AGENT_MODEL_BASE_URL.",
        "default_model": null
      }
    ],
    "models": {
      "source": "faux",
      "fast": "faux/faux-1",
      "default": "faux/faux-1",
      "strong": "faux/faux-1"
    },
    "tools": [
      {
        "name": "read",
        "summary": "Read a file in the run's work/.",
        "nodes": true,
        "calls": false,
        "available": true,
        "harnesses": [
          "pi",
          "claude-agent",
          "codex"
        ]
      },
      {
        "name": "write",
        "summary": "Write a file in the run's work/.",
        "nodes": true,
        "calls": false,
        "available": true,
        "harnesses": [
          "pi",
          "claude-agent",
          "codex"
        ]
      },
      {
        "name": "edit",
        "summary": "Edit a file in the run's work/.",
        "nodes": true,
        "calls": false,
        "available": true,
        "harnesses": [
          "pi",
          "claude-agent",
          "codex"
        ]
      },
      {
        "name": "ask_person",
        "summary": "Ask the person who started the run; the turn ends until a message answers.",
        "nodes": false,
        "calls": false,
        "available": true,
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "web_fetch",
        "summary": "Read one public web page through Parallel's extract where PARALLEL_API_KEY is set, else (or when Parallel answers no page) fetched through the guarded direct fetch: its Page plus via, \"parallel\" or \"direct\"; a URL the guarded fetch refuses is refused, never sent to Parallel.",
        "nodes": true,
        "calls": true,
        "available": true,
        "harnesses": [
          "pi",
          "claude-agent",
          "codex"
        ]
      },
      {
        "name": "web_search",
        "summary": "Search the web through Exa's keyless endpoint (mcp.exa.ai, no key; only the query leaves this server), {query, n?} -> {provider: \"exa-keyless\", query, results: [{url, title, snippet, published?}]}, or {error} (a 429 when Exa's free rate limit is reached).",
        "nodes": true,
        "calls": false,
        "available": true,
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "browser",
        "summary": "Drive a Browserbase browser: open pages, read and screenshot them, and act on them.",
        "nodes": true,
        "calls": false,
        "available": false,
        "missing": [
          "BROWSERBASE_API_KEY",
          "BROWSERBASE_PROJECT_ID"
        ],
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "monid.discover",
        "summary": "Search monid's catalog of paid data endpoints in plain words: { results: [{ provider, endpoint, description, score, price }] }.",
        "nodes": false,
        "calls": false,
        "available": false,
        "missing": [
          "MONID_API_KEY"
        ],
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "monid.inspect",
        "summary": "One monid endpoint before it runs: the JSON Schemas of its input (path, query, body), its price, notes and documentation.",
        "nodes": false,
        "calls": false,
        "available": false,
        "missing": [
          "MONID_API_KEY"
        ],
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "monid.run",
        "summary": "Run one monid endpoint, paid per call from the monid wallet: its output, price and cost; a slow provider is waited for, about two minutes at most.",
        "nodes": false,
        "calls": false,
        "available": false,
        "missing": [
          "MONID_API_KEY"
        ],
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "pdf_pages",
        "summary": "A workflow call: { path, maxPages?, dpi? } -> { name, pageCount, dpi, pages: [{ page, image }], text }; the document's first pages drawn as PNGs under work/pages/<stem>/<dpi>/ (the dpi lowered so a page's long side is at most 1568 px), from the server's documents (--documents) or the run's work directory.",
        "nodes": false,
        "calls": true,
        "call_only": true,
        "available": true,
        "harnesses": [
          "pi"
        ]
      },
      {
        "name": "llm",
        "summary": "A workflow call: { prompt, system?, maxTokens?, tier? } -> { text, model, usage, cost_usd }; one completion on the model of the tier (default), no tools and no loop.",
        "nodes": false,
        "calls": true,
        "call_only": true,
        "available": true,
        "harnesses": [
          "pi"
        ]
      }
    ],
    "workflows": {
      "nodes": [
        "agent",
        "decide",
        "extract",
        "report"
      ],
      "node_tools": [
        "read",
        "write",
        "edit"
      ],
      "adapters": [
        "runNode"
      ]
    },
    "features": {
      "agents": {
        "create": true,
        "list": true,
        "update": true,
        "revisions": true
      },
      "archive": {
        "agents": true,
        "runs": true,
        "list_param": "archived",
        "routes": [
          "POST /agents/{id}/archive",
          "POST /agents/{id}/unarchive",
          "POST /runs/{id}/archive",
          "POST /runs/{id}/unarchive"
        ]
      },
      "home": {
        "export": false,
        "import": false,
        "check": false
      },
      "runs": {
        "stop": true,
        "cancel": true,
        "kill": false,
        "list": true,
        "kinds": [
          "agentic",
          "workflow"
        ]
      },
      "messages": {
        "steer": true,
        "answer": true,
        "follow_up": true,
        "steer_workflow_runs": false
      },
      "timeline": {
        "long_poll": true,
        "sse": true,
        "live_rows": true,
        "live_workflow_rows": false
      },
      "files": {
        "upload": false,
        "read": true,
        "range": false,
        "during_run": true
      },
      "quotes": false,
      "usage": {
        "basis": "estimate",
        "meters": [
          "tokens"
        ]
      },
      "efforts": [
        "low",
        "medium",
        "high"
      ],
      "thinking": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "browser": "none",
      "sign_ins": false,
      "vault": false,
      "query": false
    },
    "regions": [
      {
        "id": "local",
        "jurisdiction": null,
        "state": "live"
      }
    ],
    "links": {
      "openapi": "/v2/openapi.json"
    },
    "limits": {
      "max_body_bytes": 1048576,
      "max_upload_bytes": null,
      "max_files_per_run": 0,
      "max_message_chars": 20000,
      "max_concurrent_runs": 4976,
      "timeline_max_wait_ms": 25000,
      "timeline_page_rows": 500,
      "idempotency_ttl_s": 86400,
      "input_wait_s": null,
      "max_cost_usd": null
    }
  }
}
