    "agent_id": "support-triage",
    "definition": {
      "id": "support-triage",
      "version": 2,
      "name": "Support triage",
      "description": "Classifies a support ticket and drafts the reply.",
      "workflow": {
        "v": 2,
        "name": "support-triage",
        "schemas": {
          "Ticket": {
            "type": "object",
            "required": [
              "subject",
              "body"
            ],
            "properties": {
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "Triage": {
            "type": "object",
            "required": [
              "category",
              "urgency",
              "summary"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "billing",
                  "bug",
                  "account",
                  "question"
                ]
              },
              "urgency": {
                "type": "number"
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "Reply": {
            "type": "object",
            "required": [
              "reply"
            ],
            "properties": {
              "reply": {
                "type": "string"
              }
            }
          }
        },
        "input": {
          "schemaId": "Ticket"
        },
        "output": {
          "schemaId": "Reply",
          "path": "reply"
        },
        "root": {
          "node": "chain",
          "steps": [
            {
              "node": "extract",
              "label": "classify",
              "instructions": "Classify the ticket: its category, its urgency from 1 to 10, and a one-sentence summary.",
              "out": "Triage",
              "as": "triage",
              "tier": "fast"
            },
            {
              "node": "escalate",
              "label": "urgent",
              "when": {
                "predicate": "gte",
                "path": "triage.urgency",
                "n": 8
              },
              "kind": "review",
              "stage": "gate",
              "summary": "urgency 8 or more goes to the on-call person"
            },
            {
              "node": "extract",
              "label": "draft reply",
              "instructions": "Draft a short, kind reply that says what happens next.",
              "out": "Reply",
              "as": "reply"
            }
          ]
        }
      },
