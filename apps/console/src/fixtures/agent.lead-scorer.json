    "definition": {
      "id": "lead-scorer",
      "version": 1,
      "name": "Lead scorer",
      "description": "Scores an inbound lead and decides the next step.",
      "workflow": {
        "v": 2,
        "name": "lead-scorer",
        "schemas": {
          "Lead": {
            "type": "object",
            "required": [
              "company",
