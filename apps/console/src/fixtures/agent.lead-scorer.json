            "required": [
              "qualified",
              "next_step"
            ],
            "properties": {
              "qualified": {
                "type": "boolean"
              },
              "next_step": {
                "type": "string"
              }
            }
          }
        },
        "input": {
          "schemaId": "Lead"
        },
        "output": {
