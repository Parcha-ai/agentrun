        "agent_id": "lead-scorer",
        "definition": {
          "id": "lead-scorer",
          "version": 1,
          "name": "Lead scorer",
          "description": "Scores an inbound lead and decides the next step.",
          "workflow": {
            "v": 2,
            "name": "lead-scorer",
            "schemas": {
              "Lead": {
                "type": "object",
                "required": [
                  "company",
                  "note"
                ],
                "properties": {
                  "company": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "Facts": {
                "type": "object",
                "required": [
                  "score",
                  "reason"
                ],
                "properties": {
                  "score": {
                    "type": "number"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "Next": {
                "type": "object",
                "required": [
                  "qualified",
                  "next_step"
                ],
                "properties": {
                  "qualified": {
                    "type": "boolean"
                  },
                  "next_step": {
                    "type": "string"
                  }
                }
              }
            },
            "input": {
              "schemaId": "Lead"
            },
            "output": {
              "schemaId": "Next",
              "path": "next"
            },
            "root": {
              "node": "chain",
              "steps": [
                {
                  "node": "extract",
                  "label": "score",
                  "instructions": "Score the lead from 0 to 100 and say why in one sentence.",
                  "out": "Facts",
                  "as": "facts",
                  "tier": "fast"
                },
                {
                  "node": "decide",
                  "label": "qualify",
                  "instructions": "Decide whether the lead is qualified, and the next step.",
                  "out": "Next",
                  "as": "next"
                }
              ]
            }
          },
          "harness": "pi",
          "skills": [],
          "tools": []
        },
