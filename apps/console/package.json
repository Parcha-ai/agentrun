{
  "name": "@parcha/agentrun-ui",
  "private": true,
  "type": "module",
  "description": "Shared AgentRun administration console and native v2 client, with a standalone server entry.",
  "scripts": {
    "generate:contract": "node scripts/generate-contract.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && npm run build:library && node ../../scripts/build-console.mjs --stamp",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node build-library.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/schibsted-grotesk": "5.1.1",
    "@headlessui/react": "2.2.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "lucide-react": "0.468.0",
    "marked": "15.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "openapi-typescript": "6.7.6",
    "postcss": "8.5.32",
    "storybook": "10.6.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "version": "0.1.0-beta.28",
  "license": "Apache-2.0",
  "files": [
    "dist/library",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/library/types/apps/console/src/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./styles.css": "./dist/library/style.css"
  },
  "overrides": {
    "openapi-typescript": {
      "undici": "6.29.1"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  }
}
