{
  "name": "agentrun-console",
  "private": true,
  "type": "module",
  "description": "The AgentRun Server console: agents, runs and the playground over agentrun.v2/0, built to static files.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/schibsted-grotesk": "5.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.2.3",
    "lucide-react": "0.468.0",
    "marked": "15.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "storybook": "8.6.14",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
