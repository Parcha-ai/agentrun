{"workflow":{"v":2,"name":"disk-settle-invoices","schemas":{"Input":{"type":"object","additionalProperties":false,"required":["batch","invoices"],"properties":{"batch":{"type":"string","minLength":1,"description":"The name of the batch, for the settlement note."},"invoices":{"type":"array","minItems":1,"description":"The invoices to charge, each once.","items":{"type":"object","additionalProperties":false,"required":["invoice","cents"],"properties":{"invoice":{"type":"string","description":"The invoice number: the charge's idempotency key."},"cents":{"type":"integer","minimum":1,"description":"The amount to charge, in cents."}}}}}},"Charge":{"type":"object","required":["invoice","receipt","cents"],"properties":{"invoice":{"type":"string"},"receipt":{"type":"string","description":"The paid tool's receipt for this charge."},"cents":{"type":"integer"}}},"Note":{"type":"object","additionalProperties":false,"required":["note"],"properties":{"note":{"type":"string","description":"One sentence for the finance team: how many invoices were settled and for how much."}}},"Result":{"type":"object","additionalProperties":false,"required":["batch","charged","cents","receipts","note"],"properties":{"batch":{"type":"string"},"charged":{"type":"integer"},"cents":{"type":"integer"},"receipts":{"type":"array","items":{"type":"object"}},"note":{"type":"string"}}}},"input":{"schemaId":"Input"},"output":{"schemaId":"Result","path":"result"},"root":{"node":"chain","steps":[{"node":"map","label":"charges","itemsPath":"invoices","as":"charges","resultPath":"charge","maxConcurrency":1,"body":{"node":"call","label":"charge","via":"tool","tool":"charge","args":{"invoice":"{item.invoice}","cents":"{item.cents}"},"out":"Charge","as":"charge","deadline_s":30}},{"node":"agent","label":"note","out":"Note","as":"note","state":{"batch":"{batch}","charged":"{charges}"},"instructions":"Every invoice in charged has been paid once. Write the settlement note for the batch."},{"node":"code","label":"finish