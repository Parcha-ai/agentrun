{
  "name": "@parcha/agentrun-web",
  "version": "0.1.0-beta.59",
  "description": "Web search and web fetch for agents: providers asked in an order given as data, a breaker per provider, a per-run page cache read in parts, and a direct fetch through an injected public-host guard.",
  "keywords": [
    "agentrun",
    "web-search",
    "web-fetch",
    "parallel",
    "firecrawl",
    "exa"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=24.22.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text-urls": {
      "types": "./dist/text-urls.d.ts",
      "default": "./dist/text-urls.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@parcha/pi-browser": "0.1.0-beta.59"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
