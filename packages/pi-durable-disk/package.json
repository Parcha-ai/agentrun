{
  "name": "@parcha/pi-durable-disk",
  "version": "0.1.0-beta.24",
  "description": "The agent is the workspace: its conversation and its files live together in one directory on a disk. Mount it on any Linux host or container, release it, and mount it elsewhere: the agent carries on.",
  "keywords": [
    "pi",
    "pi-durable",
    "archil",
    "disk",
    "durable",
    "agent",
    "fence",
    "lease",
    "supervisor"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lease": {
      "types": "./dist/lease.d.ts",
      "default": "./dist/lease.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "default": "./dist/internals.js"
    },
    "./box": {
      "types": "./dist/box-host.d.ts",
      "default": "./dist/box-host.js"
    },
    "./bin/archil-scoped": "./bin/archil-scoped",
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-durable-disk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin/archil-scoped",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && (test -f ../pi-transport/dist/index.d.ts || npm --prefix ../pi-transport run build) && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "test": "node --test --test-timeout=240000 'test/*.test.ts' 'test/examples/*.test.ts'",
    "test:acceptance": "node --test --test-concurrency=1 'test/acceptance/*.test.ts'",
    "test:live": "node --test --test-concurrency=1 'test/live/*.test.ts'",
    "test:live:claim": "node --test --test-concurrency=1 test/live/claim.live.test.ts test/live/record-home.live.test.ts",
    "test:live:env": "node --test --test-concurrency=1 test/live/env.live.test.ts",
    "test:live:lifecycle": "node --test --test-concurrency=1 test/live/lifecycle.live.test.ts",
    "test:live:run": "node --test --test-concurrency=1 test/live/run.live.test.ts",
    "test:live:store": "node --test --test-concurrency=1 test/live/store.live.test.ts",
    "test:live:supervise": "node --test --test-concurrency=1 test/live/supervise.live.test.ts",
    "test:live:supervise-slow": "node --test --test-concurrency=1 test/live/supervise-slow.live.test.ts",
    "test:live:with-claim": "node --test --test-concurrency=1 test/live/with-claim.live.test.ts",
    "test:live:docker": "PDA_LIVE_DOCKER=1 node --test --test-concurrency=1 test/live/docker.live.test.ts test/live/docker-park.live.test.ts",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "test:live:box": "PDA_LIVE_MODAL_BOX=1 node --test --test-concurrency=1 test/live/box-host.live.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/chord": ">=1.0.4 <1.4.0",
    "@earendil-works/pi-durable": ">=1.0.4 <1.4.0",
    "@parcha/pi-transport": "0.1.0-beta.24"
  },
  "dependencies": {
    "disk": "1.7.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@parcha/pi-transport": "0.1.0-beta.24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/pi-durable-disk"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "peerDependenciesMeta": {
    "@parcha/pi-transport": {
      "optional": true
    }
  }
}
