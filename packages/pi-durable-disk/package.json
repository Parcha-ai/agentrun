{
  "name": "@parcha/pi-durable-disk",
  "version": "0.1.0-beta.33",
  "description": "A durable run journal and CLI for one host, with places served by agentrun-serve.",
  "keywords": [
    "pi",
    "pi-durable",
    "disk",
    "durable",
    "agent",
    "fence"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "default": "./dist/internals.js"
    },
    "./secret-name": {
      "types": "./dist/secret-name.d.ts",
      "default": "./dist/secret-name.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-durable-disk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "test": "node --test --test-timeout=240000 'test/*.test.ts' 'test/examples/*.test.ts'",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "typebox": "1.3.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/pi-durable-disk"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
