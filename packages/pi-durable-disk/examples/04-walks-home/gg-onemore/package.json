{
  "name": "pi-durable-disk-example-walks-home-gg-onemore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Golden Gate one-more-thing: the agent finds the bridge direction in Qwen3.5-27B, has Jev pick the strength, edits one layer's weights, serves it, and switches its own conversation onto it.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test 'pi/test/*.test.ts' 'e2e/test/*.test.ts' 'chat/test/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node e2e/run.ts",
    "bundle:extra": "esbuild chat/gg-extra.ts --bundle --platform=node --format=esm --target=node22 --external:@earendil-works/* --external:@parcha/pi-durable-disk --outfile=dist/gg-extra.mjs --log-level=warning",
    "bundle:vm": "esbuild e2e/vm-app.ts --bundle --platform=node --format=esm --target=node22 --external:@earendil-works/* --external:@parcha/pi-durable-disk --outfile=dist/gg-vm-app.mjs --log-level=warning"
  },
  "dependencies": {
    "modal": "0.11.0"
  }
}
