{
  "name": "@parcha/agentrun-serve",
  "version": "0.1.0-beta.15",
  "private": true,
  "description": "The Agentrun v2 API on your own machine: agent homes and their runs, served on loopback.",
  "keywords": [
    "agentrun",
    "agent",
    "pi",
    "pi-durable",
    "server",
    "api"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentrun-serve": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "@parcha/pi-durable-agent": "0.1.0-beta.15",
    "@parcha/pi-durable-disk": "0.1.0-beta.15"
  },
  "peerDependencies": {
    "@earendil-works/chord": ">=1.1.0 <1.4.0",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-durable": ">=1.1.0 <1.4.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/serve"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
