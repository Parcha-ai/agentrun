{
  "name": "@parcha/agentrun-serve",
  "version": "0.1.0-beta.31",
  "description": "The Agentrun v2 API on your own machine: an agent store's agents, revisions and runs, served on loopback.",
  "keywords": [
    "agentrun",
    "agent",
    "pi",
    "pi-durable",
    "server",
    "api"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentrun-serve": "./launcher/agentrun-serve"
  },
  "files": [
    "dist",
    "!dist/workspace",
    "launcher",
    "harnesses",
    "skills",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-page.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "@browserbasehq/sdk": ">=2.20.0 <3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@parcha/agentrun-decisions": "0.1.0-beta.31",
    "@parcha/agentrun-dsl": "0.1.0-beta.31",
    "@parcha/agentrun-harness-claude": "0.1.0-beta.31",
    "@parcha/agentrun-harness-codex": "0.1.0-beta.31",
    "@parcha/agentrun-jev": "0.1.0-beta.31",
    "@parcha/agentrun-kernel": "0.1.0-beta.31",
    "@parcha/agentrun-pi": "0.1.0-beta.31",
    "@parcha/pi-browser": "0.1.0-beta.31",
    "@parcha/pi-durable-agent": "0.1.0-beta.31",
    "@parcha/pi-durable-disk": "0.1.0-beta.31",
    "@parcha/pi-transport": "0.1.0-beta.31",
    "@secretlint/core": "13.1.0",
    "@secretlint/profiler": "13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "croner": "11.0.0",
    "disk": "1.12.0",
    "typebox": "1.3.27",
    "undici": "^8.12.2",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-durable": "1.5.0",
    "opencode-ai": "1.19.5"
  },
  "peerDependenciesMeta": {
    "opencode-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@parcha/agentrun-computer": "0.1.0-beta.31",
    "opencode-ai": "1.19.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/serve"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
