{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "score", "summary"],
  "properties": {
    "verdict": { "enum": ["good", "bad"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": { "type": "string", "minLength": 1 }
  }
}
