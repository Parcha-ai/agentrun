{
  "server": "hubspot",
  "description": "A fake HubSpot toolkit (Composio's) for the CRM cases. It serves the four actions the package names, with each one's arguments shaped as Composio's input_parameters (trimmed to what the package uses) and its answers in Composio's {data, successful, error} envelope. It answers each call with the first answer whose `when` arguments all equal the call's, else `default`, and records every call for the graders. It never reaches HubSpot. It holds two contacts: 51234 (Avery Stanhope-Ruiz, avery.stanhope-ruiz@ramp.com) and 51999 (Casey Mendez, casey.mendez@northwind-payments.com).",
  "tools": {
    "HUBSPOT_READ_CRM_CONTACT_BY_ID": {
      "description": "Reads one HubSpot contact by its internal CRM object id, with the properties asked for.",
      "input": {
        "type": "object",
        "required": [
          "contactId"
        ],
        "properties": {
          "contactId": {
            "type": "string",
            "description": "Unique internal HubSpot CRM object ID for the contact, which must be valid and existing."
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Contact property names to include in the response; if omitted, all available properties are returned."
          },
          "associations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Object types (e.g., 'companies', 'deals') to include associated object IDs in the response."
          },
          "archived": {
            "type": "boolean",
            "description": "Set to true to include only archived contacts; defaults to false."
          }
        }
      },
      "answers": [
        {
          "when": {
            "contactId": "51234"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"51234\",\"properties\":{\"hs_object_id\":\"51234\",\"firstname\":\"Avery\",\"lastname\":\"Stanhope-Ruiz\",\"email\":\"avery.stanhope-ruiz@ramp.com\",\"company\":\"Ramp\",\"jobtitle\":\"Senior Manager, Risk & Compliance\",\"lifecyclestage\":\"lead\",\"lead_fit_score\":null},\"createdAt\":\"2026-10-02T14:21:07.000Z\",\"updatedAt\":\"2026-11-08T15:03:00.000Z\",\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        },
        {
          "when": {
            "contactId": "51999"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"51999\",\"properties\":{\"hs_object_id\":\"51999\",\"firstname\":\"Casey\",\"lastname\":\"Mendez\",\"email\":\"casey.mendez@northwind-payments.com\",\"company\":\"Northwind Payments\",\"jobtitle\":\"VP Finance\",\"lifecyclestage\":\"opportunity\",\"lead_fit_score\":\"88\"},\"createdAt\":\"2026-10-02T14:21:07.000Z\",\"updatedAt\":\"2026-11-08T15:03:00.000Z\",\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"Contact not found\"}"
          }
        ]
      }
    },
    "HUBSPOT_SEARCH_CONTACTS_BY_CRITERIA": {
      "description": "Searches HubSpot contacts with filter groups, a text query, sorting and pagination.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A string to search across default text properties of contacts (e.g., name, email)."
          },
          "filterGroups": {
            "type": "array",
            "description": "Filters within a group are ANDed; multiple groups are ORed.",
            "items": {
              "type": "object",
              "required": [
                "filters"
              ],
              "properties": {
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "propertyName",
                      "operator"
                    ],
                    "properties": {
                      "propertyName": {
                        "type": "string"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "EQ",
                          "NEQ",
                          "LT",
                          "LTE",
                          "GT",
                          "GTE",
                          "BETWEEN",
                          "IN",
                          "NOT_IN",
                          "HAS_PROPERTY",
                          "NOT_HAS_PROPERTY",
                          "CONTAINS_TOKEN",
                          "NOT_CONTAINS_TOKEN"
                        ]
                      },
                      "value": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Contact property internal names to include in the response."
          },
          "limit": {
            "type": "integer",
            "description": "The maximum number of contacts to return."
          },
          "after": {
            "type": "string",
            "description": "The cursor token for pagination."
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"total\":1,\"results\":[{\"id\":\"51234\",\"properties\":{\"email\":\"avery.stanhope-ruiz@ramp.com\",\"firstname\":\"Avery\",\"lastname\":\"Stanhope-Ruiz\",\"company\":\"Ramp\"}}]},\"successful\":true,\"error\":null}"
          }
        ]
      }
    },
    "HUBSPOT_CREATE_CRM_OBJECT_WITH_PROPERTIES": {
      "description": "Creates a new HubSpot CRM object (here a note) with the given properties and associations to existing objects.",
      "input": {
        "type": "object",
        "required": [
          "objectType",
          "properties",
          "associations"
        ],
        "properties": {
          "objectType": {
            "type": "string",
            "description": "Type of CRM object to create (e.g., 'contacts', 'companies', 'deals', 'notes')."
          },
          "properties": {
            "type": "object",
            "description": "Key-value pairs for the object's properties, keyed by internal HubSpot property names."
          },
          "associations": {
            "type": "array",
            "description": "Associations between the new object and existing CRM objects.",
            "items": {
              "type": "object",
              "required": [
                "types"
              ],
              "properties": {
                "to__id": {
                  "type": "string",
                  "description": "Unique ID of the existing CRM object to associate with the new object."
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "associationCategory",
                      "associationTypeId"
                    ],
                    "properties": {
                      "associationCategory": {
                        "type": "string",
                        "enum": [
                          "HUBSPOT_DEFINED",
                          "USER_DEFINED",
                          "INTEGRATOR_DEFINED"
                        ]
                      },
                      "associationTypeId": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "answers": [
        {
          "when": {
            "objectType": "notes"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"90001\",\"properties\":{\"hs_object_id\":\"90001\"},\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"The fake HubSpot toolkit accepts a notes create only.\"}"
          }
        ]
      }
    },
    "HUBSPOT_PARTIALLY_UPDATE_CONTACT_USING_CONTACT_ID": {
      "description": "Partially updates the given properties of an existing HubSpot contact, identified by its contactId.",
      "input": {
        "type": "object",
        "required": [
          "contactId",
          "properties"
        ],
        "properties": {
          "contactId": {
            "type": "string",
            "description": "Unique HubSpot identifier for the contact to be partially updated."
          },
          "properties": {
            "type": "object",
            "description": "Contact properties to update, keyed by internal HubSpot property names."
          }
        }
      },
      "answers": [
        {
          "when": {
            "contactId": "51234"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"51234\",\"properties\":{\"hs_object_id\":\"51234\"},\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"The fake HubSpot toolkit updates contact 51234 only.\"}"
          }
        ]
      }
    }
  }
}
