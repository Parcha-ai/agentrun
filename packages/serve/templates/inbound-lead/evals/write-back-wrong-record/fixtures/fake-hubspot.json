{
  "server": "hubspot",
  "description": "A fake HubSpot toolkit (Composio's) for the CRM cases. It serves the four actions the package names, with each one's arguments shaped as Composio's input_parameters (trimmed to what the package uses) and its answers in Composio's {data, successful, error} envelope. It answers each call with the first answer whose `when` arguments all equal the call's, else `default`, and records every call for the graders. It never reaches HubSpot. It holds two contacts: 51234 (Avery Stanhope-Ruiz, avery.stanhope-ruiz@ramp.com, of company 77001, Ramp) and 51999 (Casey Mendez, casey.mendez@northwind-payments.com). It has no update action: a note is the one write.",
  "tools": {
    "HUBSPOT_READ_CONTACT": {
      "description": "Retrieves a HubSpot contact by its ID.",
      "input": {
        "type": "object",
        "required": [
          "contactId"
        ],
        "properties": {
          "contactId": {
            "type": "string",
            "description": "Unique internal HubSpot CRM object ID for the contact, which must be valid and existing."
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Contact property names to include in the response; if omitted, all available properties are returned."
          },
          "associations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Object types (e.g., 'companies', 'deals') to include associated object IDs in the response."
          },
          "archived": {
            "type": "boolean",
            "description": "Set to true to include only archived contacts; defaults to false."
          }
        }
      },
      "answers": [
        {
          "when": {
            "contactId": "51234"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"51234\",\"properties\":{\"hs_object_id\":\"51234\",\"firstname\":\"Avery\",\"lastname\":\"Stanhope-Ruiz\",\"email\":\"avery.stanhope-ruiz@ramp.com\",\"company\":\"Ramp\",\"jobtitle\":\"Senior Manager, Risk & Compliance\",\"lifecyclestage\":\"lead\"},\"associations\":{\"companies\":{\"results\":[{\"id\":\"77001\",\"type\":\"contact_to_company\"}]}},\"createdAt\":\"2026-10-02T14:21:07.000Z\",\"updatedAt\":\"2026-11-08T15:03:00.000Z\",\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        },
        {
          "when": {
            "contactId": "51999"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"51999\",\"properties\":{\"hs_object_id\":\"51999\",\"firstname\":\"Casey\",\"lastname\":\"Mendez\",\"email\":\"casey.mendez@northwind-payments.com\",\"company\":\"Northwind Payments\",\"jobtitle\":\"VP Finance\",\"lifecyclestage\":\"opportunity\"},\"createdAt\":\"2026-10-02T14:21:07.000Z\",\"updatedAt\":\"2026-11-08T15:03:00.000Z\",\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"Contact not found\"}"
          }
        ]
      }
    },
    "HUBSPOT_SEARCH_CONTACTS_BY_CRITERIA": {
      "description": "Searches HubSpot contacts with filter groups, a text query, sorting and pagination.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A string to search across default text properties of contacts (e.g., name, email)."
          },
          "filterGroups": {
            "type": "array",
            "description": "Filters within a group are ANDed; multiple groups are ORed.",
            "items": {
              "type": "object",
              "required": [
                "filters"
              ],
              "properties": {
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "propertyName",
                      "operator"
                    ],
                    "properties": {
                      "propertyName": {
                        "type": "string"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "EQ",
                          "NEQ",
                          "LT",
                          "LTE",
                          "GT",
                          "GTE",
                          "BETWEEN",
                          "IN",
                          "NOT_IN",
                          "HAS_PROPERTY",
                          "NOT_HAS_PROPERTY",
                          "CONTAINS_TOKEN",
                          "NOT_CONTAINS_TOKEN"
                        ]
                      },
                      "value": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Contact property internal names to include in the response."
          },
          "limit": {
            "type": "integer",
            "description": "The maximum number of contacts to return."
          },
          "after": {
            "type": "string",
            "description": "The cursor token for pagination."
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"total\":1,\"results\":[{\"id\":\"51234\",\"properties\":{\"email\":\"avery.stanhope-ruiz@ramp.com\",\"firstname\":\"Avery\",\"lastname\":\"Stanhope-Ruiz\",\"company\":\"Ramp\"}}]},\"successful\":true,\"error\":null}"
          }
        ]
      }
    },
    "HUBSPOT_GET_COMPANY": {
      "description": "Retrieves a HubSpot company by its ID.",
      "input": {
        "type": "object",
        "required": [
          "companyId"
        ],
        "properties": {
          "companyId": {
            "type": "string",
            "description": "Unique HubSpot identifier for the company to retrieve."
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Company property names to include in the response; if omitted, only default properties (name, domain, createdate, etc.) are returned."
          },
          "associations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Object types (e.g., 'contacts', 'deals') to include associated object IDs in the response."
          },
          "archived": {
            "type": "boolean",
            "description": "Set to true to include only archived companies; defaults to false (active companies)."
          }
        }
      },
      "answers": [
        {
          "when": {
            "companyId": "77001"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"id\":\"77001\",\"properties\":{\"hs_object_id\":\"77001\",\"name\":\"Ramp\",\"domain\":\"ramp.com\",\"industry\":\"FINANCIAL_SERVICES\",\"country\":\"United States\",\"numberofemployees\":\"1200\"},\"createdAt\":\"2026-09-12T10:00:00.000Z\",\"updatedAt\":\"2026-11-01T09:00:00.000Z\",\"archived\":false},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"Company not found\"}"
          }
        ]
      }
    },
    "HUBSPOT_CREATE_NOTE": {
      "description": "Creates a new HubSpot CRM note. Use when you need to add a timestamped note with optional attachments and associations to contacts, companies, deals, or tickets.",
      "input": {
        "type": "object",
        "required": [
          "hs_timestamp"
        ],
        "properties": {
          "hs_timestamp": {
            "type": "string",
            "description": "Creation time of the note. Either an ISO-8601 UTC timestamp (e.g., '2021-11-12T15:48:22Z') or Unix milliseconds since epoch."
          },
          "hs_note_body": {
            "type": "string",
            "description": "Text content of the note (up to 65,536 characters)."
          },
          "associations": {
            "type": "array",
            "description": "List of associations to link with the note (e.g., contacts, deals, companies).",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique ID of the existing CRM object to associate with the note."
                    }
                  }
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "associationCategory",
                      "associationTypeId"
                    ],
                    "properties": {
                      "associationCategory": {
                        "type": "string",
                        "enum": [
                          "HUBSPOT_DEFINED",
                          "USER_DEFINED",
                          "INTEGRATOR_DEFINED"
                        ]
                      },
                      "associationTypeId": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"id\":\"90001\",\"properties\":{\"hs_object_id\":\"90001\"},\"archived\":false,\"createdAt\":\"2026-11-08T15:05:00.000Z\",\"updatedAt\":\"2026-11-08T15:05:00.000Z\"},\"successful\":true,\"error\":null}"
          }
        ]
      }
    }
  }
}
