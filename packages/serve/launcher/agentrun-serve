#!/bin/sh
# agentrun-serve's launcher: it hands the server its secrets over a pipe and starts it with none of them in its
# environment, so no process of the server's user can read them from /proc/<pid>/environ or cmdline.
#
#   agentrun-serve [ARG...]              the server (../dist/cli.js beside this launcher) with ARGs
#   agentrun-serve -- COMMAND [ARG...]   COMMAND, which starts the server (the image's: tini -- node .../cli.js)
#
# Each secret named below that is set goes into one pipe as NAME=VALUE and a NUL, AGENTRUN_SECRETS_LEN bytes in all,
# on fd AGENTRUN_SECRETS_FD; the server reads exactly that many bytes first thing and closes the pipe. First, each
# secret moves out of the environment into this shell's own memory, so no process it starts (mktemp, mkfifo, rm, env)
# inherits one; only this launcher's own initial environment ever held them, and its writer's, a fork of it (below). The
# pipe is a FIFO whose name is gone before any secret is written, and only that fork of this shell writes it, with its
# builtin printf, as the server reads, so the secrets may come to any length; it is gone once the last byte is in the
# pipe, or at its next write once the server has exited without reading. `env -u` drops every name from what COMMAND
# inherits too. The condition:
# this runs before any run's process exists. A process of the same user started earlier could open the FIFO while it is
# named.
#
# AGENTRUN_SEAL_KEY, the key the server keeps every secret under (src/seal-key.ts), is one of them. Not set, the
# server keeps its own in seal/seal.key in its data directory, beside the store, made at its first start: this launcher
# neither makes nor reads one.
#
# AGENTRUN_STORE_URL, the store's connection, is one too: its URL may hold the database's password. The server and the
# runner each read it from what they were handed (secrets.ts secret), and no run is handed it.
#
# BROWSERBASE_PROJECT_ID is no secret, but a tool key's field: every field a person may save is on this list, so a
# saved one is read by the same name and reaches a run's process over its pipe, as the launcher's does.
#
# COMPOSIO_API_KEY and AGENTRUN_COMPOSIO_API_KEY, the Composio account keys a Composio MCP server saved with `api_key_env` reads
# (src/composio-made.ts COMPOSIO_KEY_ENV): only the server's and the runner's own code reads it (a Composio save's calls,
# a claim's MCP header to Composio's origin), and no run is handed it.
#
# ARCHIL_API_KEY, the Archil account key, and every computer provider's key from E2B_API_KEY to MODAL_TOKEN_SECRET
# (src/computer-keys.ts COMPUTER_KEY_NAMES): only the server's and the runner's own code reads one (the Archil claim,
# a computer's create), and no run is handed one.
#
# CURSOR_API_KEY, the owner's Cursor API key, is Cursor's alone (src/harness-cursor.ts): a run of Cursor is handed it,
# and no run of any other harness (src/run-secrets.ts keysFor, the table's ownKeys).
#
# After MODAL_TOKEN_SECRET, the keys of pi-ai's other providers, which a pi run's model may need (GEMINI_API_KEY,
# DEEPSEEK_API_KEY, Bedrock's AWS keys, ...): the server holds each, and a run's process gets one over its pipe only when
# its model is that provider's (../src/model.ts' PROVIDER_KEYS). The custody test checks every key pi-ai's table names is
# here. Any other variable named like a key (a KEY, TOKEN, SECRET, PASSWORD, PASSWD, PASS, PAT, CREDENTIAL, CREDENTIALS or
# DSN segment, or a last PWD after another) stays in the server's environment, as this list does not take it, and in no
# run's: name it here to keep it from the server's too.
SECRETS='AGENTRUN_TOKEN AGENTRUN_TOKENS AGENTRUN_API_KEY AGENTRUN_STORE_URL AGENT_MODEL_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY BROWSERBASE_API_KEY BROWSERBASE_PROJECT_ID KERNEL_API_KEY OPENROUTER_API_KEY PARTICLE_API_KEY TYPESAFE_API_KEY PARALLEL_API_KEY MONID_API_KEY CURSOR_API_KEY AGENTRUN_SEAL_KEY AGENTRUN_LAUNCH_HOOK_SECRET COMPOSIO_API_KEY AGENTRUN_COMPOSIO_API_KEY ARCHIL_API_KEY E2B_API_KEY ORGO_API_KEY PHONE_HARNESS_API_KEY AGENT37_API_KEY AGENT37_SSH_KEY DAYTONA_API_KEY BOXD_API_KEY MORPH_API_KEY SMOLCLOUD_API_KEY GROUNDBOX_API_KEY VERCEL_TOKEN SPRITES_TOKEN INSTABOX_API_KEY FREESTYLE_API_KEY CLOUDFLARE_RELAY_TOKEN FLY_API_TOKEN RENDER_API_KEY MODAL_TOKEN_ID MODAL_TOKEN_SECRET ANTHROPIC_AUTH_TOKEN ANTHROPIC_OAUTH_TOKEN AI_GATEWAY_API_KEY ANT_LING_API_KEY AWS_ACCESS_KEY_ID AWS_BEARER_TOKEN_BEDROCK AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AZURE_OPENAI_API_KEY BASETEN_API_KEY CEREBRAS_API_KEY CLOUDFLARE_API_KEY COPILOT_GITHUB_TOKEN DEEPSEEK_API_KEY FIREWORKS_API_KEY GEMINI_API_KEY GOOGLE_CLOUD_API_KEY GROQ_API_KEY HF_TOKEN KIMI_API_KEY META_API_KEY MINIMAX_API_KEY MINIMAX_CN_API_KEY MISTRAL_API_KEY MOONSHOT_API_KEY NVIDIA_API_KEY OPENCODE_API_KEY QWEN_TOKEN_PLAN_API_KEY QWEN_TOKEN_PLAN_CN_API_KEY RADIUS_API_KEY TOGETHER_API_KEY XAI_API_KEY XIAOMI_API_KEY XIAOMI_TOKEN_PLAN_AMS_API_KEY XIAOMI_TOKEN_PLAN_CN_API_KEY XIAOMI_TOKEN_PLAN_SGP_API_KEY ZAI_API_KEY ZAI_CODING_CN_API_KEY'
set -eu
# Each secret out of the environment and into an unexported variable of this shell (agentrun_secret_<NAME>).
for name in $SECRETS; do
  eval "given=\${$name+x}"
  [ -n "$given" ] || continue
  eval "agentrun_secret_$name=\${$name}"
  unset "$name"
done
# Written only by this shell's own printf, never a program that would take a secret on its command line.
case $(command -V printf 2>/dev/null) in
  *builtin*) ;;
  *) echo "agentrun-serve: this sh has no builtin printf, so it cannot hand the secrets over without a command line holding them" >&2; exit 1 ;;
esac
# Lengths in bytes: the C locale, for this shell only; the caller's own goes back before the exec.
locale=${LC_ALL-}
locale_set=${LC_ALL+x}
LC_ALL=C

# Every other program this launcher runs, it runs here, before it writes a secret.
dir=$(mktemp -d "${TMPDIR:-/tmp}/agentrun-serve.XXXXXX")
mkfifo -m 600 "$dir/secrets"
# The server's end read-only on 3, the writer's write-only on 4: once the server is gone, no read end is left, and the
# writer's next write fails (EPIPE) rather than wait. Opened read-write first, so neither one-way open waits for the other.
exec 4<>"$dir/secrets"
exec 3<"$dir/secrets"
exec 4>"$dir/secrets"
rm -f "$dir/secrets"
rmdir "$dir"

# From here to the exec: this shell's builtins and forks of it only.
total=0
for name in $SECRETS; do
  eval "given=\${agentrun_secret_$name+x}"
  [ -n "$given" ] || continue
  eval "value=\${agentrun_secret_$name}"
  total=$((total + ${#name} + ${#value} + 2))
done
# The writer: a fork of this shell, so still its builtin printf, with the launcher's command line, which holds no secret.
# It writes beside the server rather than before it, so a pipe of any size is enough. It holds no read end of the pipe and none of the caller's stdio (a
# caller waiting for its output to end waits for the server alone). Forked twice, it belongs to init (in the image, tini)
# and is reaped there, never left a zombie under a server that reaps only its own children.
(
  (
    for name in $SECRETS; do
      eval "given=\${agentrun_secret_$name+x}"
      [ -n "$given" ] || continue
      eval "value=\${agentrun_secret_$name}"
      printf '%s=%s\000' "$name" "$value" >&4 || exit 1
    done
  ) &
) 3<&- </dev/null >/dev/null 2>&1
exec 4>&-
if [ -n "$locale_set" ]; then LC_ALL=$locale; else unset LC_ALL; fi

if [ "${1-}" = "--" ]; then
  shift
else
  # The server beside this launcher, found by node from this file's real path: a package manager's bin is a link. The
  # code is CommonJS (no --input-type): a worker thread inherits its process's flags, and Node refuses a worker from a
  # file that inherits --input-type, as a codemode script's sandbox is.
  set -- node -e 'const { realpathSync } = require("node:fs"); const { pathToFileURL } = require("node:url"); const cli = new URL("../dist/cli.js", pathToFileURL(realpathSync(process.argv[1]))); process.argv[1] = cli.pathname; import(cli.href).catch((error) => { process.exitCode = 1; console.error(error); });' "$0" "$@"
fi
set -- AGENTRUN_SECRETS_FD=3 "AGENTRUN_SECRETS_LEN=$total" "$@"
for name in $SECRETS; do
  set -- -u "$name" "$@"
done
exec env "$@"
