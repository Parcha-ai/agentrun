Patch: 017-key-refused
Reason: the CLI retries a provider's 401 a dozen times over about three minutes while the run reads Working, and no retry of a refused key can pass; the session's model proxy says the first paid 401 once (onKeyRefused, with the provider's words), and the harness halts the turn as the spend cap does, failed in the words the CLI ends on after its retries
Upstream: ours
Pins: a refused key ends a claude-agent run at the provider's first 401: one request, no retries, and the run's error in plain words
---
diff --git a/packages/harness-claude-code/src/harness.ts b/packages/harness-claude-code/src/harness.ts
index 4f05772..e4d549c 100644
--- a/packages/harness-claude-code/src/harness.ts
+++ b/packages/harness-claude-code/src/harness.ts
@@ -452,6 +452,8 @@ export function claudeCodeHarness(options: ClaudeCodeHarnessOptions = {}): Harne
         onCap: (cap) => {
           if (cap !== 'concurrency') ctx.halt?.(spendCapped(cap));
         },
+        // A refused key fails the turn at the provider's first 401, in the words the CLI would end on after its retries.
+        onKeyRefused: (detail) => ctx.halt?.(new Error(`Failed to authenticate. API Error: 401${detail ? ` ${detail}` : ''}`)),
         // Without the app's own log, the handler's default: a refused model call is a warning in the Function's logs, not silence.
         ...(options.log ? { log: (message: string, fields?: Record<string, unknown>) => log(`claude-agent gateway: ${message}`, fields) } : {}),
       });
