Patch: 007-fake-anthropic-real-shape
Reason: the fake API's usage is flat and it never thinks; the real API nests cache_creation and output_tokens_details in usage and answers with thinking blocks, which the usage parse and the block allowlist must see
Upstream: ours
Pins: on each current model, a node that names no level thinks at medium on the wire, a node's own level reaches it, and the betas and content blocks the CLI sends are the allowlists
---
diff --git a/packages/harness-claude-code/test/fake-anthropic.ts b/packages/harness-claude-code/test/fake-anthropic.ts
--- a/packages/harness-claude-code/test/fake-anthropic.ts
+++ b/packages/harness-claude-code/test/fake-anthropic.ts
@@ -58,10 +58,13 @@ export interface FakeRequest {
   results: Record<string, string>;
 }
 
+/** A thinking model's blocks before its answer: its thinking (signed), and a redacted one. */
+type Thought = { thinking?: string; redacted?: string };
+
 /** What the model says for one request. */
 export type FakeReply =
-  | { text: string }
-  | { tool: { name: string; input: unknown; id?: string }; text?: string }
+  | ({ text: string } & Thought)
+  | ({ tool: { name: string; input: unknown; id?: string }; text?: string } & Thought)
   | { error: { status: number; type: string; message: string } }
   /** Hold the response open (after `message_start`) until `release` resolves, then say `then`. */
   | { hold: Promise<void>; then: FakeReply };
@@ -252,10 +255,13 @@ export async function fakeAnthropic(options: FakeAnthropicOptions): Promise<Fake
     }
     if ('error' in reply) return fail(reply.error.status, reply.error.type, reply.error.message);
     const blocks: Block[] = [];
+    if ('thinking' in reply && reply.thinking) blocks.push({ type: 'thinking', thinking: reply.thinking, signature: `sig_fake_${requests.length}` });
+    if ('redacted' in reply && reply.redacted) blocks.push({ type: 'redacted_thinking', data: reply.redacted });
     if ('text' in reply && reply.text) blocks.push({ type: 'text', text: reply.text });
     if ('tool' in reply) blocks.push({ type: 'tool_use', id: reply.tool.id ?? `toolu_fake_${String(++toolSeq).padStart(4, '0')}_${Date.now().toString(36)}`, name: reply.tool.name, input: reply.tool.input });
     const stopReason = 'tool' in reply ? 'tool_use' : 'end_turn';
-    const usage = { input_tokens: Math.ceil(text.length / 4), output_tokens: 12, cache_creation_input_tokens: 0, cache_read_input_tokens: 0 };
+    // The real API's shape, nested objects included (a recorded response is in test/fixtures/).
+    const usage = { input_tokens: Math.ceil(text.length / 4), cache_creation_input_tokens: 0, cache_read_input_tokens: 0, cache_creation: { ephemeral_5m_input_tokens: 0, ephemeral_1h_input_tokens: 0 }, output_tokens: 12, output_tokens_details: { thinking_tokens: 0 }, service_tier: 'standard' };
     const id = `msg_fake_${requests.length}`;
     const metadata = { gateway: { cost, gatewayCost: cost } };
 
@@ -265,10 +271,16 @@ export async function fakeAnthropic(options: FakeAnthropicOptions): Promise<Fake
     }
     res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', 'request-id': `req_fake_${requests.length}` });
     const ev = (type: string, data: unknown) => res.write(`event: ${type}\ndata: ${JSON.stringify(data)}\n\n`);
-    ev('message_start', { type: 'message_start', message: { id, type: 'message', role: 'assistant', model: parsed.model, content: [], stop_reason: null, stop_sequence: null, usage: { ...usage, output_tokens: 1 } } });
+    ev('message_start', { type: 'message_start', message: { id, type: 'message', role: 'assistant', model: parsed.model, content: [], stop_reason: null, stop_sequence: null, usage: { ...usage, output_tokens: 1, output_tokens_details: undefined } } });
     if (held) await held;
     blocks.forEach((b, index) => {
-      if (b.type === 'text') {
+      if (b.type === 'thinking') {
+        ev('content_block_start', { type: 'content_block_start', index, content_block: { type: 'thinking', thinking: '', signature: '' } });
+        ev('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'thinking_delta', thinking: b.thinking } });
+        ev('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'signature_delta', signature: b.signature } });
+      } else if (b.type === 'redacted_thinking') {
+        ev('content_block_start', { type: 'content_block_start', index, content_block: { type: 'redacted_thinking', data: b.data } });
+      } else if (b.type === 'text') {
         ev('content_block_start', { type: 'content_block_start', index, content_block: { type: 'text', text: '' } });
         ev('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'text_delta', text: b.text } });
       } else {
@@ -277,7 +289,7 @@ export async function fakeAnthropic(options: FakeAnthropicOptions): Promise<Fake
       }
       ev('content_block_stop', { type: 'content_block_stop', index });
     });
-    ev('message_delta', { type: 'message_delta', delta: { stop_reason: stopReason, stop_sequence: null }, usage: { output_tokens: 12 }, provider_metadata: metadata });
+    ev('message_delta', { type: 'message_delta', delta: { stop_reason: stopReason, stop_sequence: null }, usage: { input_tokens: usage.input_tokens, cache_creation_input_tokens: 0, cache_read_input_tokens: 0, output_tokens: 12, output_tokens_details: { thinking_tokens: 0 } }, provider_metadata: metadata });
     ev('message_stop', { type: 'message_stop' });
     res.end();
   }
