{
  "name": "@parcha/agentrun-dsl",
  "version": "0.1.0-beta.14",
  "description": "Composable, typed workflows for agents",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agentrun": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./browser/worker": {
      "types": "./dist/browser/worker.d.ts",
      "import": "./dist/browser/worker.js"
    },
    "./browser/executor": {
      "types": "./dist/browser/executor.d.ts",
      "import": "./dist/browser/executor.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "import": "./dist/demo.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "import": "./dist/recovery/index.js"
    },
    "./recovery/testing": {
      "types": "./dist/recovery/testing/index.d.ts",
      "import": "./dist/recovery/testing/index.js"
    },
    "./schema": "./schema/workflow.schema.json"
  },
  "imports": {
    "#platform": {
      "browser": "./dist/platform/browser.js",
      "default": "./dist/platform/node.js"
    },
    "#guards": {
      "browser": "./dist/platform/guards-browser.js",
      "default": "./dist/platform/guards-node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/dsl"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
