{
  "v": 2,
  "name": "sequence",
  "schemas": {
    "Any": {
      "type": "object"
    },
    "Item": {
      "type": "object"
    },
    "Found": {
      "type": "object",
      "required": [
        "id",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    }
  },
  "output": {
    "schemaId": "Any",
    "path": "final"
  },
  "root": {
    "node": "chain",
    "steps": [
      {
        "node": "call",
        "label": "search",
        "via": "tool",
        "tool": "lookup",
        "args": {
          "id": "x"
        },
        "out": "Found",
        "as": "search",
        "deadline_s": 30
      },
      {
        "node": "code",
        "label": "score",
        "code": "s => (({ score: s.search.score * 2 }))"
      },
      {
        "node": "code",
        "label": "finish",
        "code": "s => (({ final: { score: s.score } }))"
      }
    ]
  }
}
