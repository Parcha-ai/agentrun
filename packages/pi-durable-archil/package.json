{
  "name": "@parcha/pi-durable-archil",
  "version": "0.1.0-beta.9",
  "description": "A pi-durable host on an Archil disk: one owner per run, a fence, durable commits, and a supervisor.",
  "keywords": [
    "pi",
    "pi-durable",
    "archil",
    "durable",
    "agent",
    "fence",
    "lease",
    "supervisor"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lease": {
      "types": "./dist/lease.d.ts",
      "default": "./dist/lease.js"
    },
    "./bin/archil-scoped": "./bin/archil-scoped",
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-durable-archil": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin/archil-scoped",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "test": "node --test 'test/*.test.ts'",
    "test:acceptance": "node --test --test-concurrency=1 'test/acceptance/*.test.ts'",
    "test:live": "node --test --test-concurrency=1 'test/live/*.test.ts'",
    "test:live:claim": "node --test --test-concurrency=1 test/live/claim.live.test.ts",
    "test:live:env": "node --test --test-concurrency=1 test/live/env.live.test.ts",
    "test:live:run": "node --test --test-concurrency=1 test/live/run.live.test.ts",
    "test:live:store": "node --test --test-concurrency=1 test/live/store.live.test.ts",
    "test:live:supervise": "node --test --test-concurrency=1 test/live/supervise.live.test.ts",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  },
  "peerDependencies": {
    "@earendil-works/chord": "~1.0.4",
    "@earendil-works/pi-durable": "~1.0.4"
  },
  "dependencies": {
    "disk": "1.7.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/pi-durable-archil"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
