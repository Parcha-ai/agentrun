{
  "name": "@parcha/agentrun-computer",
  "version": "0.1.0-beta.37",
  "description": "The open platform's computer protocol: a daemon in every computer, and one provisioner per vendor, starting with Docker.",
  "keywords": [
    "agentrun",
    "computer",
    "sandbox",
    "docker",
    "daytona",
    "boxd"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=24.22.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./fake-ui-driver": {
      "types": "./dist/fake-ui-driver.d.ts",
      "default": "./dist/fake-ui-driver.js"
    },
    "./docker": {
      "types": "./dist/docker.d.ts",
      "default": "./dist/docker.js"
    },
    "./daytona": {
      "types": "./dist/daytona.d.ts",
      "default": "./dist/daytona.js"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "default": "./dist/modal.js"
    },
    "./e2b": {
      "types": "./dist/e2b.d.ts",
      "default": "./dist/e2b.js"
    },
    "./agent37": {
      "types": "./dist/agent37.d.ts",
      "default": "./dist/agent37.js"
    },
    "./boxd": {
      "types": "./dist/boxd.d.ts",
      "default": "./dist/boxd.js"
    },
    "./orgo": {
      "types": "./dist/orgo.d.ts",
      "default": "./dist/orgo.js"
    },
    "./orgo-desktop": {
      "types": "./dist/orgo-desktop.d.ts",
      "default": "./dist/orgo-desktop.js"
    },
    "./phone-harness": {
      "types": "./dist/phone-harness.d.ts",
      "default": "./dist/phone-harness.js"
    },
    "./browserbase": {
      "types": "./dist/browserbase.d.ts",
      "default": "./dist/browserbase.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./local-chrome": {
      "types": "./dist/local-chrome.d.ts",
      "default": "./dist/local-chrome.js"
    },
    "./surface": {
      "types": "./dist/surface/index.d.ts",
      "default": "./dist/surface/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "box",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build:phoned": "node scripts/build-phoned.mjs",
    "build:ui-fixture": "node scripts/build-ui-fixture.mjs",
    "check:phoned": "node scripts/check-phoned-jar.mjs",
    "test:phoned": "node scripts/build-phoned.mjs --test && node scripts/build-phoned.mjs --fake && node --test test/phoned/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:docker": "node --test --test-timeout=900000 test/docker/*.test.mjs",
    "test:daytona": "node --test --test-timeout=1800000 test/daytona/*.test.mjs",
    "test:modal": "node --test --test-timeout=1800000 test/modal/*.test.mjs",
    "test:e2b": "node --test --test-timeout=1800000 test/e2b/*.test.mjs",
    "test:boxd": "node --test --test-timeout=1800000 test/boxd/*.test.mjs",
    "conformance": "node dist/conformance/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/computer"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
