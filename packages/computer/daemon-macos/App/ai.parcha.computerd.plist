<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Computerd's LaunchAgent, registered by the app through SMAppService from Contents/Library/LaunchAgents. It runs
     only in the Aqua session (the logged-in desktop), where input and capture work, and launchd restarts it. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.parcha.computerd</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Computerd</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>ai.parcha.computerd</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
