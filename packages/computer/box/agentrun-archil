#!/bin/sh
# agentrun-archil: the root helper of a remote computer, which keeps one run's work folder on the owner's Archil disk
# at /workspace. It does five things and nothing else, each with fixed arguments to the archil client, to iptables and
# ip6tables, or to computerd:
#
#   netlock <region>
#   mount  <disk> <region> agents/<agent>/runs/<run>/work   the disk token as one line on fd 0
#   revoke <disk> <region> agents/<agent>/runs/<run>/work   the disk token as one line on fd 0
#   serve
#   checkin
#
# netlock the computer's firewall, run first: the tool user sends nothing, loopback included; root reaches Archil alone.
# mount   archil mount <disk>:/<path> /workspace --region <region>: exclusive, so no other client writes the folder.
# revoke  the same with --force: takes the folder back from a computer that is gone and left its delegation behind.
# serve   becomes `computerd sync-serve`, resident, holding no token: on its socket it takes one fixed byte and answers
#         the exit code of `archil sync /workspace` (every write so far durable), coalesced; it exits when the mount
#         goes or its socket is taken away.
# checkin takes serve's socket away, then archil checkin /workspace: lets go of the folder.
#
# Install it root:root 0755 at /usr/local/sbin/agentrun-archil. The provider runs it as root through its own exec (the
# image's user is root), never through sudo: the image has none. The run's tools run as agentrun-tool, through
# computerd, with no way to root at all.
#
# The token is read from fd 0 and handed to archil only in the environment of its exec (archil reads it nowhere else),
# never as an argument and never in a file. Every argument is checked here, whoever calls: a caller that is not root, a
# wrong verb or count, a newline, a disk, region or folder of any other shape (an absolute path, `.` or `..`, an empty
# or extra segment), a mountpoint that is a link or not empty, or a token of any other shape exits 2 and runs nothing.
# A serve or checkin with nothing mounted exits 3 and runs nothing. A mount or revoke in a computer whose /proc lets a
# user see another's processes (no hidepid=2 or invisible) exits 4 and runs nothing; each first remounts /proc with
# hidepid=2, which a computer whose root may not remount leaves as it was. A netlock that cannot lock the tools' network
# exits 4, and so does a serve whose computerd is not root's alone.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
IFS=' 	
'
unset ENV CDPATH

ARCHIL=/usr/bin/archil
MP=/workspace
MOUNTS=/proc/self/mounts
MOUNT=/usr/bin/mount
IPTABLES=/usr/sbin/iptables
IP6TABLES=/usr/sbin/ip6tables
GETENT=/usr/bin/getent
STATUS=/proc/self/status
IF_INET6=/proc/net/if_inet6
TOOL=agentrun-tool
CHAIN=AGENTRUN-NET
COMPUTERD=/opt/agentrun/computerd
SOCK=/run/agentrun-archil/archil.sock
ROOT_UID=0
HELD_TOP=/

refuse() {
  printf 'agentrun-archil: %s\n' "$1" >&2
  exit 2
}

[ "$(id -u)" = "$ROOT_UID" ] || refuse "run it as root, through the provider's own exec"

# A newline in any argument is refused before anything reads one: the checks below are line by line.
nl='
'
for arg in "$@"; do
  case "$arg" in *"$nl"*) refuse "an argument holds a newline" ;; esac
done

matches() { printf '%s\n' "$1" | grep -Eqx -- "$2"; }

# Whether $MP is in the mount table, as an archil mount (fuse.archil) or as anything (any).
listed() { awk -v m="$MP" -v t="$1" '$2 == m && (t == "any" || $3 == t) { f = 1 } END { exit !f }' "$MOUNTS"; }

take() {
  [ "$#" -eq 3 ] || refuse "$verb takes <disk> <region> agents/<agent>/runs/<run>/work"
  disk=$1 region=$2 folder=$3
  matches "$disk" 'dsk-[0-9a-f]{16}|[A-Za-z0-9][A-Za-z0-9._@+-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}' || refuse "the disk is a disk id (dsk-...) or owner/name"
  matches "$region" '[a-z0-9][a-z0-9-]{0,63}' || refuse "the region is lowercase letters, digits and dashes"
  matches "$folder" 'agents/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/runs/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/work' || refuse "the folder is agents/<agent>/runs/<run>/work, nothing else"
  # The box's /proc (its last mount there) must hide each user's processes from the others, hidepid=2 or invisible as
  # newer kernels name it: else the run's tools could see this root archil client's. No image sets it, so it is
  # remounted so first, as root may where it holds CAP_SYS_ADMIN; a box where that fails is refused by the check.
  "$MOUNT" -o remount,hidepid=2 /proc >/dev/null 2>&1 || :
  if ! awk '$2 == "/proc" && $3 == "proc" { o = $4 } END { exit !(o ~ /(^|,)hidepid=(2|invisible)(,|$)/) }' "$MOUNTS"; then
    printf 'agentrun-archil: /proc is not mounted with hidepid=2 (or invisible): the run'"'"'s tools could see the root archil client'"'"'s processes\n' >&2
    exit 4
  fi
  if listed fuse.archil; then
    # This folder, mounted here already (a box the server finds again): nothing to do. Any other is refused.
    awk -v m="$MP" -v a="$disk:/$folder" -v b="$disk:/$folder[$region]" '$2 == m && $3 == "fuse.archil" && ($1 == a || $1 == b) { f = 1 } END { exit !f }' "$MOUNTS" || refuse "$MP holds another archil mount"
    printf 'agentrun-archil: %s is mounted already\n' "$MP" >&2
    exit 0
  fi
  listed any && refuse "$MP is another mount"
  [ ! -L "$MP" ] && [ -d "$MP" ] || refuse "$MP is not a real directory"
  [ "$(realpath -e "$MP")" = "$MP" ] || refuse "$MP is not its own real path"
  [ -z "$(ls -A "$MP")" ] || refuse "$MP is not empty"
  token=
  IFS= read -r token || [ -n "$token" ] || refuse "no token on fd 0"
  [ "${#token}" -ge 16 ] && [ "${#token}" -le 4096 ] || refuse "the token is not a disk token"
  case "$token" in *[!A-Za-z0-9._~+/=-]*) refuse "the token is not a disk token" ;; esac
  # In the environment of archil's exec alone (this shell's own was fixed at its start and never holds it), and archil
  # runs as root, so no other user reads it there.
  ARCHIL_MOUNT_TOKEN=$token
  export ARCHIL_MOUNT_TOKEN
  exec "$ARCHIL" mount $force "$disk:/$folder" "$MP" --region "$region"
}

# serve and checkin act on the archil mount at $MP; with none there (a computer whose mount went), nothing is held, and
# they say so with exit 3.
held() {
  [ "$#" -eq 0 ] || refuse "$verb takes no argument"
  if ! listed fuse.archil; then
    printf 'agentrun-archil: nothing is mounted at %s\n' "$MP" >&2
    exit 3
  fi
}

# Whether $COMPUTERD is root's alone: a regular file, it and every folder above it (to $HELD_TOP) owned by root and
# writable by no group or other user, so no link and no ACL. Else a user who could rename an entry on the path could
# put another program there, which serve would run as root. `ls -ldn` is in BusyBox and coreutils alike; a trailing `.`
# (an SELinux label) is allowed, a `+` (an ACL) is not.
rootsalone() {
  [ -f "$COMPUTERD" ] && [ ! -L "$COMPUTERD" ] || return 1
  x=$COMPUTERD
  while :; do
    set -- $(ls -ldn "$x" 2>/dev/null)
    case "${1-}" in ?????[!w]??[!w]? | ?????[!w]??[!w]?.) ;; *) return 1 ;; esac
    [ "${3-}" = "$ROOT_UID" ] || return 1
    [ "$x" = "$HELD_TOP" ] || [ "$x" = / ] && return 0
    x=${x%/*}
    x=${x:-/}
  done
}

# serve: computerd's resident sync server, as root, with fixed arguments alone: the socket, the mountpoint, the mount
# table, the archil client and the tool user's group, which may connect. No token: its stdin is not passed on.
serve() {
  held "$@"
  rootsalone || { printf 'agentrun-archil: computerd at %s is not root'"'"'s alone, so serve runs nothing\n' "$COMPUTERD" >&2; exit 4; }
  gid=$(id -g "$TOOL" 2>/dev/null) || { printf 'agentrun-archil: there is no user %s\n' "$TOOL" >&2; exit 4; }
  exec "$COMPUTERD" sync-serve --socket "$SOCK" --mountpoint "$MP" --mounts "$MOUNTS" --archil "$ARCHIL" --gid "$gid" </dev/null
}

# netlock <region>: the box's firewall, before any tool runs and before the mount. In a chain of its own, jumped to
# first from OUTPUT, for IPv4 and IPv6 alike. Its first rule: the tool user sends nothing at all, loopback and replies
# included. A box's loopback is not the tools' own: the provider's control daemon may listen there with no
# authentication (Daytona's toolbox, on 2280), and it runs commands as the box's own user, who has sudo and an open
# network; and a reply to an inbound connection (a provider's preview address) is the tool user answering the outside.
# The tools need no port of their own: they have no network yet. Then loopback and replies pass for everyone else; root
# sends DNS, TCP 8100 to the region's mount endpoint alone (resolved here, from the region) and TCP 32050 (the file
# servers, whose addresses the endpoint gives only at the mount, so any address: root's one wide rule); everything else
# of root's is dropped; other users (the box's own, which holds sudo anyway) are left as they are. IPv6 is locked when
# the box has it (an address in /proc/net/if_inet6, ::1 included); a box with none has no IPv6 to lock. The rules are
# read back whole. No CAP_NET_ADMIN, no iptables (or no ip6tables in a box with IPv6), no such user, no address for
# the endpoint, or a read-back that differs exits 4.
lockfail() {
  printf 'agentrun-archil: the box cannot lock its tools'"'"' network: %s\n' "$1" >&2
  exit 4
}

rules() {
  # $1 iptables or ip6tables, $2 the endpoint's addresses, $3 their prefix length. One rule a line, as -S prints it.
  printf '%s\n' "-N $CHAIN" \
    "-A $CHAIN -m owner --uid-owner $uid -j DROP" \
    "-A $CHAIN -o lo -j ACCEPT" \
    "-A $CHAIN -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT" \
    "-A $CHAIN -p udp -m owner --uid-owner 0 -m udp --dport 53 -j ACCEPT" \
    "-A $CHAIN -p tcp -m owner --uid-owner 0 -m tcp --dport 53 -j ACCEPT"
  for a in $2; do printf '%s\n' "-A $CHAIN -d $a/$3 -p tcp -m owner --uid-owner 0 -m tcp --dport 8100 -j ACCEPT"; done
  printf '%s\n' "-A $CHAIN -p tcp -m owner --uid-owner 0 -m tcp --dport 32050 -j ACCEPT" \
    "-A $CHAIN -m owner --uid-owner 0 -j DROP"
}

lockwith() {
  # $1 the binary, $2 the addresses, $3 their prefix length: applied, then read back whole. A box locked before (a found
  # box, locked again) has its chain flushed and refilled: for that while, a guard first in OUTPUT drops the tool user's
  # every packet, so a tool program left running never meets an open network. The guard goes only once the read-back
  # passes; a lock that fails keeps it, closed.
  t=$1
  guard="-m owner --uid-owner $uid -j DROP"
  "$t" -w -I OUTPUT 1 $guard || lockfail "$t cannot guard the tool user while it locks"
  "$t" -w -N "$CHAIN" 2>/dev/null || "$t" -w -F "$CHAIN" || lockfail "$t cannot make its chain"
  n=0
  while "$t" -w -C OUTPUT -j "$CHAIN" 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -le 8 ] && "$t" -w -D OUTPUT -j "$CHAIN" || lockfail "$t cannot move its jump"
  done
  "$t" -w -I OUTPUT 1 -j "$CHAIN" || lockfail "$t cannot jump to its chain"
  rules "$t" "$2" "$3" | while IFS= read -r line; do
    case "$line" in -N*) continue ;; esac
    # Each line is the rule's own words, split on spaces: none holds one.
    "$t" -w $line || exit 1
  done || lockfail "$t refused a rule"
  [ "$("$t" -w -S "$CHAIN")" = "$(rules "$t" "$2" "$3")" ] || lockfail "$t reads back other rules than it was given"
  [ "$("$t" -w -S OUTPUT | sed -n 2p)" = "-A OUTPUT -j $CHAIN" ] || lockfail "$t does not jump to its chain first"
  n=0
  while "$t" -w -C OUTPUT $guard 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -le 8 ] && "$t" -w -D OUTPUT $guard || lockfail "$t cannot lift its guard"
  done
}

netlock() {
  [ "$#" -eq 1 ] || refuse "netlock takes <region>"
  region=$1
  matches "$region" '[a-z0-9]+-[a-z0-9][a-z0-9-]{0,62}' || refuse "the region is a provider, a dash and its region, such as aws-us-east-1"
  cap=$(awk '$1 == "CapEff:" { print $2 }' "$STATUS")
  matches "$cap" '[0-9a-f]{1,16}' || lockfail "its capabilities cannot be read"
  [ $(( (0x$cap >> 12) & 1 )) -eq 1 ] || lockfail "root has no CAP_NET_ADMIN here"
  [ -x "$IPTABLES" ] || lockfail "iptables is not installed"
  v6on=
  # Read, never sized: a /proc file's size is 0 whatever it holds.
  [ -n "$(cat "$IF_INET6" 2>/dev/null)" ] && v6on=1
  [ -z "$v6on" ] || [ -x "$IP6TABLES" ] || lockfail "the box has IPv6, and ip6tables is not installed"
  uid=$(id -u "$TOOL" 2>/dev/null) || lockfail "there is no user $TOOL"
  matches "$uid" '[1-9][0-9]{0,9}' || lockfail "the user $TOOL is root"
  endpoint="mount.green.${region#*-}.${region%%-*}.prod.archil.com"
  v4=$("$GETENT" ahostsv4 "$endpoint" 2>/dev/null | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print $1 }' | sort -u | tr '\n' ' ')
  v6=$("$GETENT" ahostsv6 "$endpoint" 2>/dev/null | awk '$1 ~ /^[0-9a-f:]+$/ && $1 !~ /^::ffff:/ { print $1 }' | sort -u | tr '\n' ' ')
  [ -n "$v6on" ] || v6=
  [ -n "$v4$v6" ] || lockfail "$endpoint has no address"
  lockwith "$IPTABLES" "$v4" 32
  if [ -n "$v6on" ]; then
    lockwith "$IP6TABLES" "$v6" 128
  else
    printf 'agentrun-archil: the box has no IPv6, so there are no IPv6 rules to lock\n' >&2
  fi
  printf 'agentrun-archil: the tools'"'"' network is locked; root reaches %s on 8100 and any address on 32050\n' "$endpoint" >&2
}

[ "$#" -ge 1 ] || refuse "say netlock, mount, revoke, serve or checkin"
verb=$1
shift
case "$verb" in
  netlock) netlock "$@" ;;
  mount) force= && take "$@" ;;
  revoke) force=--force && take "$@" ;;
  serve) serve "$@" ;;
  # serve's socket goes first, so serve exits and no sync is asked of a folder let go.
  checkin) held "$@" && rm -f -- "$SOCK" && exec "$ARCHIL" checkin "$MP" ;;
  *) refuse "say netlock, mount, revoke, serve or checkin" ;;
esac
