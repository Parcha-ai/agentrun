{
  "name": "@parcha/agentrun-tools",
  "version": "0.1.0-beta.32",
  "private": true,
  "description": "The open platform's tools protocol: one shape every tool source fills in, and one adapter per source, starting with MCP servers.",
  "keywords": [
    "agentrun",
    "tools",
    "mcp"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=24.11.0"
  },
  "exports": {
    "./sources/mcp": {
      "types": "./dist/sources/mcp/index.d.ts",
      "default": "./dist/sources/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai"
}
