Patch: 002-message-prefix
Reason: an error or refusal from the shared layer named a package that is not installed here; it names this package
Upstream: ours
Pins: the shared process layer's errors name this package
---
diff --git a/packages/harness-process/src/builtins.ts b/packages/harness-process/src/builtins.ts
index 160428d..c78eec8 100644
--- a/packages/harness-process/src/builtins.ts
+++ b/packages/harness-process/src/builtins.ts
@@ -136,7 +136,7 @@ export class BuiltinCalls {
    * failed): the drive is halted, and the hook must refuse the call.
    */
   begin(call: BuiltinCall): Promise<BuiltinStart> {
-    if (!call.callId) return Promise.reject(new TypeError(`harness-world-process: a built-in ${call.name} call has no call id`));
+    if (!call.callId) return Promise.reject(new TypeError(`agentrun-kernel: a built-in ${call.name} call has no call id`));
     const first = this.begun.get(call.callId);
     if (first) return this.again(call.callId, first);
     const start = this.beginOnce(call);
@@ -156,7 +156,7 @@ export class BuiltinCalls {
     const known = this.ctx.state().effects.get(toolKey(callId));
     if (known?.status === 'completed') return { run: false, result: { text: String(known.output ?? ''), isError: false } };
