{
  "$schema": "../../../schema/task.schema.json",
  "id": "fake.notes.new-note",
  "version": 1,
  "title": "Make a note (fake world)",
  "split": "dev",
  "tags": ["fake"],
  "needs": { "os": "macos", "osVersion": "fake", "kind": "desktop", "apps": ["fake.notes"] },
  "params": {
    "title": { "pick": ["Groceries", "Trip ideas", "Q3 plan"] },
    "body": { "pick": ["oat milk", "pack the charger", "ship phase 2"] }
  },
  "setup": [
    { "method": "exec.run", "params": { "argv": ["delete-note", "{{title}} {{nonce}}"], "timeoutMs": 1000 } },
    { "method": "apps.launch", "params": { "id": "fake.notes" } }
  ],
  "instruction": "In Notes, make a note titled \"{{title}} {{nonce}}\" whose body is \"{{body}}\".",
  "budget": { "steps": 8, "usd": 0.1, "wall_s": 10 },
  "checks": [
    { "id": "one", "kind": "exec", "why": "Exactly one note has the title.", "argv": ["count-notes", "{{title}} {{nonce}}"], "stdout": { "equals": "1" } },
    { "id": "body", "kind": "exec", "why": "Its body is the asked text.", "argv": ["note", "{{title}} {{nonce}}"], "stdout": { "equals": "{{body}}" } },
    { "id": "listed", "kind": "ui", "why": "Notes lists it.", "app": "fake.notes", "find": { "role": "row", "name": { "equals": "{{title}} {{nonce}}" } }, "min": 1, "max": 1 }
  ],
  "teardown": [{ "method": "exec.run", "params": { "argv": ["delete-note", "{{title}} {{nonce}}"], "timeoutMs": 1000 } }],
  "oracle": [{ "method": "exec.run", "params": { "argv": ["make-note", "{{title}} {{nonce}}", "{{body}}"], "timeoutMs": 1000 } }]
}
