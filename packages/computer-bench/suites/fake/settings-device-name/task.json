{
  "$schema": "../../../schema/task.schema.json",
  "id": "fake.settings.device-name",
  "version": 1,
  "title": "Say the device's name (fake world)",
  "split": "heldout",
  "tags": ["fake", "answer"],
  "needs": { "os": "macos", "osVersion": "fake", "kind": "desktop", "apps": ["fake.settings"] },
  "params": { "name": { "pick": ["Kitchen iPad", "Lab Phone 7", "Studio Mac 2"] } },
  "setup": [
    { "method": "exec.run", "params": { "argv": ["set", "device_name", "{{name}}"], "timeoutMs": 1000 } },
    { "method": "apps.launch", "params": { "id": "fake.settings" } }
  ],
  "instruction": "What is this device's name, as Settings shows it? Answer with the name alone.",
  "budget": { "steps": 4, "usd": 0.1, "wall_s": 10 },
  "checks": [
    { "id": "answer", "kind": "answer", "why": "The answer is the device name setup set.", "text": { "equals": "{{name}}" } }
  ],
  "teardown": [{ "method": "exec.run", "params": { "argv": ["set", "device_name", "Fake Phone"], "timeoutMs": 1000 } }]
}
