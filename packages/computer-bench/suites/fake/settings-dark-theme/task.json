{
  "$schema": "../../../schema/task.schema.json",
  "id": "fake.settings.dark-theme",
  "version": 1,
  "title": "Turn the dark theme on (fake world)",
  "split": "dev",
  "tags": ["fake"],
  "needs": { "os": "macos", "osVersion": "fake", "kind": "desktop", "groups": ["ui"], "apps": ["fake.settings"] },
  "setup": [
    { "method": "exec.run", "params": { "argv": ["set", "dark", "no"], "timeoutMs": 1000 } },
    { "method": "apps.launch", "params": { "id": "fake.settings" } }
  ],
  "instruction": "In Settings, turn the dark theme on.",
  "budget": { "steps": 6, "usd": 0.1, "wall_s": 10 },
  "checks": [
    { "id": "dark", "kind": "exec", "why": "The dark setting is yes.", "argv": ["get", "dark"], "stdout": { "equals": "yes" } }
  ],
  "teardown": [{ "method": "exec.run", "params": { "argv": ["set", "dark", "no"], "timeoutMs": 1000 } }],
  "oracle": [{ "method": "exec.run", "params": { "argv": ["set", "dark", "yes"], "timeoutMs": 1000 } }]
}
