{
  "$schema": "../../../schema/task.schema.json",
  "id": "fake.files.write",
  "version": 1,
  "title": "Write a file (fake world)",
  "split": "heldout",
  "tags": ["fake"],
  "needs": { "os": "macos", "osVersion": "fake", "kind": "desktop", "groups": ["files"] },
  "params": { "n": { "int": [2, 9] } },
  "setup": [{ "method": "exec.run", "params": { "argv": ["rm", "/tmp/bench-{{nonce}}.txt"], "timeoutMs": 1000 } }],
  "instruction": "Write the number {{n}} to /tmp/bench-{{nonce}}.txt.",
  "budget": { "steps": 3, "usd": 0.1, "wall_s": 10 },
  "checks": [
    { "id": "file", "kind": "file", "why": "The file holds the number.", "path": "/tmp/bench-{{nonce}}.txt", "text": { "equals": "{{n}}" } }
  ],
  "teardown": [{ "method": "exec.run", "params": { "argv": ["rm", "/tmp/bench-{{nonce}}.txt"], "timeoutMs": 1000 } }],
  "oracle": [{ "method": "exec.run", "params": { "argv": ["write", "/tmp/bench-{{nonce}}.txt", "{{n}}"], "timeoutMs": 1000 } }]
}
