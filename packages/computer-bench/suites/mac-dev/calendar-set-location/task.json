{
  "$schema": "../../../schema/task.schema.json",
  "id": "mac.calendar.set-location",
  "version": 1,
  "title": "Set the location of an existing event",
  "split": "heldout",
  "tags": ["calendar", "edit"],
  "needs": { "os": "macos", "osVersion": "26", "kind": "desktop", "groups": ["screen", "input.pointer", "input.keys"], "apps": ["com.apple.iCal"] },
  "params": {
    "title": { "pick": ["Design review", "Book club", "Parent meeting", "Interview"] },
    "room": { "pick": ["Room 4B", "Cafe Lumen", "Studio 2", "Main library, floor 3"] }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "The calendar holds only the event, tomorrow 14:00 to 15:00, with no location.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "start"], "timeoutMs": 60000 }
    },
    { "method": "apps.launch", "params": { "id": "com.apple.iCal" } }
  ],
  "instruction": "In Calendar, set the location of tomorrow's event \"{{title}} {{nonce}}\" (calendar \"computer-bench {{nonce}}\") to \"{{room}}\".",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "one-event",
      "kind": "exec",
      "why": "Exactly one event of the calendar has the title: it was edited, not copied.",
      "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "count"],
      "timeoutMs": 60000,
      "stdout": { "equals": "1" }
    },
    {
      "id": "location",
      "kind": "exec",
      "why": "The event's location property is the asked text exactly.",
      "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "location"],
      "timeoutMs": 60000,
      "stdout": { "equals": "{{room}}" }
    },
    {
      "id": "time-kept",
      "kind": "exec",
      "why": "The event is still tomorrow from 14:00 for 60 minutes: editing it did not move it.",
      "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "when"],
      "timeoutMs": 60000,
      "stdout": { "equals": "+1d 14:00 60m" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete the calendar and its events.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "teardown"], "timeoutMs": 60000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "why": "Set the event's location.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "place"], "timeoutMs": 60000 }
    }
  ]
}
