{
  "$schema": "../../../schema/task.schema.json",
  "id": "mac.textedit.new-file",
  "version": 1,
  "title": "Write and save a one-line plain text file",
  "split": "dev",
  "tags": ["textedit", "files", "create", "save-dialog"],
  "needs": { "os": "macos", "osVersion": "26", "kind": "desktop", "apps": ["com.apple.TextEdit"] },
  "params": {
    "name": { "pick": ["shopping", "call-list", "packing", "reading"] },
    "line": { "pick": ["Buy oat milk and eggs", "Call the plumber on Tuesday", "Pack the blue charger", "Finish chapter four"] }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "Close documents a run left open from the folder.",
      "params": { "argv": ["osascript", "-e", "{{file:close.applescript}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "The folder exists and is empty, so the file is not there yet.",
      "params": { "argv": ["sh", "-c", "d=\"$HOME/Documents/computer-bench-{{nonce}}\" && rm -rf \"$d\" && mkdir -p \"$d\""], "timeoutMs": 30000 }
    },
    { "method": "apps.launch", "params": { "id": "com.apple.TextEdit" } }
  ],
  "instruction": "Using TextEdit, create a plain text file named \"{{name}}.txt\" in the folder computer-bench-{{nonce}} (in Documents). Its only line is \"{{line}}\".",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 420 },
  "checks": [
    {
      "id": "content",
      "kind": "exec",
      "why": "The file exists under that name and its bytes are the line (ends trimmed): plain text, so a rich-text file fails on its {\\rtf1 header.",
      "argv": ["sh", "-c", "cat \"$HOME/Documents/computer-bench-{{nonce}}/{{name}}.txt\""],
      "stdout": { "equals": "{{line}}" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Close the document without saving.",
      "params": { "argv": ["osascript", "-e", "{{file:close.applescript}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Remove the folder.",
      "params": { "argv": ["sh", "-c", "rm -rf \"$HOME/Documents/computer-bench-{{nonce}}\""], "timeoutMs": 30000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "why": "Write the file as TextEdit's plain-text save would.",
      "params": { "argv": ["sh", "-c", "printf '%s\\n' \"{{line}}\" > \"$HOME/Documents/computer-bench-{{nonce}}/{{name}}.txt\""], "timeoutMs": 30000 }
    }
  ]
}
