{
  "$schema": "../../../schema/task.schema.json",
  "id": "mac.calendar.new-event",
  "version": 1,
  "title": "Add a timed event for tomorrow to a given calendar",
  "split": "dev",
  "tags": ["calendar", "create", "dates"],
  "needs": { "os": "macos", "osVersion": "26", "kind": "desktop", "groups": ["screen", "input.pointer", "input.keys"], "apps": ["com.apple.iCal"] },
  "params": {
    "title": { "pick": ["Dentist", "Team sync", "Call with Sam", "Yoga class"] },
    "slot": {
      "pick": [
        { "say": "9:00 to 10:00 AM", "h": 9, "m": 0, "len": 60, "want": "09:00 60m" },
        { "say": "11:30 AM to 12:00 PM", "h": 11, "m": 30, "len": 30, "want": "11:30 30m" },
        { "say": "2:00 to 3:30 PM", "h": 14, "m": 0, "len": 90, "want": "14:00 90m" },
        { "say": "4:15 to 5:00 PM", "h": 16, "m": 15, "len": 45, "want": "16:15 45m" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "The calendar exists and is empty, so the event is not there yet.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "start"], "timeoutMs": 60000 }
    },
    { "method": "apps.launch", "params": { "id": "com.apple.iCal" } }
  ],
  "instruction": "In Calendar, add an event called \"{{title}} {{nonce}}\" to the calendar \"computer-bench {{nonce}}\", tomorrow from {{slot.say}}.",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 420 },
  "checks": [
    {
      "id": "one-event",
      "kind": "exec",
      "why": "Exactly one event of the calendar has the title.",
      "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "count"],
      "timeoutMs": 60000,
      "stdout": { "equals": "1" }
    },
    {
      "id": "when",
      "kind": "exec",
      "why": "The event starts tomorrow (one day after today, computed when the check runs) at the asked time and lasts the asked length; an all-day event fails.",
      "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "when"],
      "timeoutMs": 60000,
      "stdout": { "equals": "+1d {{slot.want}}" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete the calendar and its events.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "teardown"], "timeoutMs": 60000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "why": "Make the event at tomorrow's date, computed from the Mac's clock.",
      "params": { "argv": ["osascript", "-e", "{{file:calendar.applescript}}", "make"], "timeoutMs": 60000 }
    }
  ]
}
