{
  "$schema": "../../../schema/task.schema.json",
  "id": "mobileworld.bid-file-rename",
  "version": 2,
  "title": "Rename the bid_ files in Download by date, oldest first",
  "split": "dev",
  "source": {
    "suite": "MobileWorld",
    "id": "native/bid_file_rename.py:BidFileRenameTask",
    "revision": "a026188705f4a494a12d14ddab3786a23fd2c537",
    "licence": "Apache-2.0",
    "changes": "The source's goal is Chinese; the instruction is our English translation, with \"numbered from 1\" added (the source's check wants 1 to 4 but its goal doesn't say). The fifteen files and their text are the source's. The source dated files relative to the day of the run; ours are fixed dates in March 2026, and which bid file is oldest is a param: the source's order (proposal, catering, design, supplier) is one pick, two other orders are the others. The source deleted every bid_ file in Download first; here setup moves the phone's own bid_ files and same-named files aside and teardown puts them back. Setup also asks the media scanner to re-read each file so file managers show the set dates. The checks are the source's (old names gone, exactly bid_1 to bid_4 with the right extensions, dates ascending), plus one the source didn't have: the eleven other files are still there."
  },
  "tags": ["files", "rename", "translated"],
  "needs": { "os": "android", "kind": "phone", "apps": ["com.google.android.documentsui", "com.android.documentsui", "com.google.android.apps.nbu.files", "com.sec.android.app.myfiles"] },
  "params": {
    "o": {
      "pick": [
        { "pt": "202603020930", "pn": 1, "ct": "202603091415", "cn": 2, "dt": "202603171100", "dn": 3, "st": "202603241645", "sn": 4, "want": "bid_1.txt bid_2.doc bid_3.pdf bid_4.txt" },
        { "pt": "202603171100", "pn": 3, "ct": "202603241645", "cn": 4, "dt": "202603091415", "dn": 2, "st": "202603020930", "sn": 1, "want": "bid_1.txt bid_2.pdf bid_3.txt bid_4.doc" },
        { "pt": "202603171100", "pn": 3, "ct": "202603020930", "cn": 1, "dt": "202603241645", "dn": 4, "st": "202603091415", "sn": 2, "want": "bid_1.doc bid_2.txt bid_3.txt bid_4.pdf" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "Move the phone's own bid_ files and same-named files aside, then write the four bid_ files and eleven others into Download with fixed dates, the bid files' order from the pick.",
      "params": { "argv": ["sh", "-c", "{{file:seed.sh}}"], "timeoutMs": 90000 }
    },
    {
      "method": "exec.run",
      "why": "Open the system file manager (DocumentsUI) on Download.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-t", "vnd.android.document/directory", "-d", "content://com.android.externalstorage.documents/document/primary%3ADownload"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In Download, rename the files whose names begin with bid_ in order of their creation date, earliest to latest, all in the form bid_{number}.{original extension}, numbered from 1.",
  "exec": "deny",
  "budget": { "steps": 40, "usd": 2, "wall_s": 600 },
  "checks": [
    {
      "id": "renamed-in-order",
      "kind": "exec",
      "why": "The bid_ files in Download are exactly {{o.want}} (so no old name is left, no extension changed and no other file took a bid_ name), and bid_1 to bid_4 are dated in rising order, so each number went to the right file: renaming keeps a file's date. After setup the old names are there, so an agent that does nothing fails.",
      "argv": ["sh", "-c", "{{file:check.sh}}"],
      "timeoutMs": 30000,
      "stdout": { "equals": "{{o.want}}|ascending" }
    },
    {
      "id": "others-kept",
      "kind": "exec",
      "why": "The eleven other files setup wrote are all still in Download under their own names.",
      "argv": ["sh", "-c", "cd /sdcard/Download && ls -1 ai_research_paper.pdf machine_learning_notes.txt data_analysis_report.doc chatbot_training_data.txt computer_vision_project.pdf nlp_processing_guide.doc ai_ethics_discussion.txt deep_learning_tutorial.pdf ai_deployment_strategy.doc recommendation_system.txt ai_performance_metrics.pdf 2>/dev/null | wc -l"],
      "timeoutMs": 30000,
      "stdout": { "equals": "11" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete the run's files and put back the phone's own files that setup moved aside.",
      "params": { "argv": ["sh", "-c", "{{file:restore.sh}}"], "timeoutMs": 60000 }
    }
  ],
  "oracle": [
    { "method": "ui.act", "why": "Open the search bar: Download holds more files than one screen shows, and a find sees only what is on screen.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Search" } } } }], "expect": { "text": "Search…", "timeoutMs": 5000 } } },
    { "method": "ui.act", "why": "Search by part of the name, so the search bar doesn't hold the old name after the rename.", "params": { "steps": [{ "set": { "find": { "role": "searchbox" } }, "value": "restaurant_proposal" }], "expect": { "text": "restaurant_proposal", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "foreground": true, "steps": [{ "key": "enter" }], "expect": { "text": "bid_restaurant_proposal.txt", "timeoutMs": 8000 } } },
    { "method": "ui.act", "why": "A long press selects the file.", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "bid_restaurant_proposal.txt" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "why": "Tap the selection bar's More options at the screen's top right (336,48 points), as in the Files tasks of android-dev.", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Rename", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Rename" } } } }], "expect": { "text": "New name", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox", "name": { "equals": "New name" } } }, "value": "bid_{{o.pn}}.txt" }], "expect": { "text": "bid_{{o.pn}}.txt", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "bid_restaurant_proposal.txt", "gone": true, "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "searchbox" } }, "value": "catering_menu" }], "expect": { "text": "catering_menu", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "foreground": true, "steps": [{ "key": "enter" }], "expect": { "text": "bid_catering_menu_2024.doc", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "bid_catering_menu_2024.doc" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Rename", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Rename" } } } }], "expect": { "text": "New name", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox", "name": { "equals": "New name" } } }, "value": "bid_{{o.cn}}.doc" }], "expect": { "text": "bid_{{o.cn}}.doc", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "bid_catering_menu_2024.doc", "gone": true, "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "searchbox" } }, "value": "menu_design" }], "expect": { "text": "menu_design", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "foreground": true, "steps": [{ "key": "enter" }], "expect": { "text": "bid_menu_design_contract.pdf", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "bid_menu_design_contract.pdf" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Rename", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Rename" } } } }], "expect": { "text": "New name", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox", "name": { "equals": "New name" } } }, "value": "bid_{{o.dn}}.pdf" }], "expect": { "text": "bid_{{o.dn}}.pdf", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "bid_menu_design_contract.pdf", "gone": true, "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "searchbox" } }, "value": "food_supplier" }], "expect": { "text": "food_supplier", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "foreground": true, "steps": [{ "key": "enter" }], "expect": { "text": "bid_food_supplier_quote.txt", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "bid_food_supplier_quote.txt" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Rename", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Rename" } } } }], "expect": { "text": "New name", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox", "name": { "equals": "New name" } } }, "value": "bid_{{o.sn}}.txt" }], "expect": { "text": "bid_{{o.sn}}.txt", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "bid_food_supplier_quote.txt", "gone": true, "timeoutMs": 8000 } } }
  ]
}
