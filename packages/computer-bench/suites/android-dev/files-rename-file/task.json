{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.files.rename-file",
  "version": 2,
  "title": "Rename a file in the Files app",
  "split": "dev",
  "tags": ["files", "rename"],
  "needs": { "os": "android", "kind": "phone", "apps": [["com.google.android.documentsui", "com.android.documentsui", "com.google.android.apps.nbu.files", "com.sec.android.app.myfiles"]] },
  "params": {
    "f": {
      "pick": [
        { "old": "draft", "new": "final" },
        { "old": "scan", "new": "receipt" },
        { "old": "notes", "new": "minutes" },
        { "old": "todo", "new": "done" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "A fresh folder for this run in Download, holding only the file to rename.",
      "params": { "argv": ["sh", "-c", "d=/sdcard/Download/computer-bench-{{nonce}}; rm -rf $d && mkdir -p $d && echo 'computer-bench {{nonce}}' > $d/{{f.old}}-{{nonce}}.txt"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the system file manager (DocumentsUI) on the folder.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-t", "vnd.android.document/directory", "-d", "content://com.android.externalstorage.documents/document/primary%3ADownload%2Fcomputer-bench-{{nonce}}"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Files app, rename the file {{f.old}}-{{nonce}}.txt in Download/computer-bench-{{nonce}} to {{f.new}}-{{nonce}}.txt.",
  "exec": "deny",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "only-new-name",
      "kind": "exec",
      "why": "The folder lists exactly one file, named {{f.new}}-{{nonce}}.txt: the old name is gone and no copy was made. After setup it lists {{f.old}}-{{nonce}}.txt, so an agent that does nothing fails.",
      "argv": ["ls", "-1", "/sdcard/Download/computer-bench-{{nonce}}"],
      "stdout": { "equals": "{{f.new}}-{{nonce}}.txt" }
    },
    {
      "id": "same-text",
      "kind": "exec",
      "why": "The renamed file holds the text setup wrote, so it is the same file, not a new empty one with the name.",
      "argv": ["sh", "-c", "cat /sdcard/Download/computer-bench-{{nonce}}/{{f.new}}-{{nonce}}.txt; true"],
      "stdout": { "equals": "computer-bench {{nonce}}" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete the run's folder and everything in it.",
      "params": { "argv": ["rm", "-rf", "/sdcard/Download/computer-bench-{{nonce}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    { "method": "ui.act", "why": "Wait for the folder to list the file.", "params": { "steps": [], "expect": { "text": "{{f.old}}-{{nonce}}.txt", "timeoutMs": 10000 } } },
    { "method": "ui.act", "why": "A long press selects the file.", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "{{f.old}}-{{nonce}}.txt" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "why": "Tap the selection bar's More options at the screen's top right (336,48 points). A find can't name it: the folder bar's More options, hidden under the selection bar, comes first in the tree.", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Rename", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Rename" } } } }], "expect": { "text": "New name", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox", "name": { "equals": "New name" } } }, "value": "{{f.new}}-{{nonce}}.txt" }], "expect": { "text": "{{f.new}}-{{nonce}}.txt", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "{{f.old}}-{{nonce}}.txt", "gone": true, "timeoutMs": 8000 } } }
  ]
}
