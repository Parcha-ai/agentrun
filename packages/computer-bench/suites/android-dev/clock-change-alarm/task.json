{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.clock.change-alarm",
  "version": 1,
  "title": "Move a labelled alarm to a new time in Clock",
  "split": "heldout",
  "tags": ["clock", "edit"],
  "needs": { "os": "android", "kind": "phone", "apps": ["com.google.android.deskclock", "com.android.deskclock", "com.sec.android.app.clockpackage"] },
  "params": {
    "t": {
      "pick": [
        { "from_say": "6:30 AM", "fh": "6", "fm": "30", "to_say": "6:50 AM", "th": "6", "tm": "50", "thh": "06", "tmm": "50" },
        { "from_say": "7:15 AM", "fh": "7", "fm": "15", "to_say": "8:05 AM", "th": "8", "tm": "5", "thh": "08", "tmm": "05" },
        { "from_say": "9:00 PM", "fh": "21", "fm": "0", "to_say": "9:45 PM", "th": "21", "tm": "45", "thh": "21", "tmm": "45" },
        { "from_say": "5:40 AM", "fh": "5", "fm": "40", "to_say": "5:10 AM", "th": "5", "tm": "10", "thh": "05", "tmm": "10" }
      ]
    },
    "label": { "pick": ["Yoga", "Shift", "Walk dog", "Train"] }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "No enabled alarm with this run's label is left from an earlier try.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "The alarm to move, enabled at the old time, made without UI.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.SET_ALARM", "--ei", "android.intent.extra.alarm.HOUR", "{{t.fh}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.fm}}", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}", "--ez", "android.intent.extra.alarm.SKIP_UI", "true"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the Clock app on its alarm list.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.intent.action.SHOW_ALARMS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Clock app, change the alarm labelled \"{{label}} {{nonce}}\" from {{t.from_say}} to {{t.to_say}}. Keep its label, and don't leave an alarm at the old time.",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 400 },
  "checks": [
    {
      "id": "next-alarm",
      "kind": "exec",
      "why": "AlarmManager's next alarm clock rings at the new time, {{t.thh}}:{{t.tmm}}. After setup it rings at the old time (when no other enabled alarm rings sooner, README), so an agent that does nothing fails.",
      "argv": ["sh", "-c", "dumpsys alarm | grep -A3 'Next alarm clock information' | grep 'user:0 '; true"],
      "stdout": { "matches": "time:[1-9]\\d* = \\d{4}-\\d\\d-\\d\\d {{t.thh}}:{{t.tmm}}:00" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Dismiss the alarm by its label, at whatever time it now has.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Dismiss an alarm left at the new time without the label (the agent made a new one).",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.time", "--ei", "android.intent.extra.alarm.HOUR", "{{t.th}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.tm}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Dismiss an alarm left at the old time without the label.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.time", "--ei", "android.intent.extra.alarm.HOUR", "{{t.fh}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.fm}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "why": "Drop the alarm at the old time (DISMISS deletes a one-time SKIP_UI alarm).",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Make it again at the new time with the same label.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.SET_ALARM", "--ei", "android.intent.extra.alarm.HOUR", "{{t.th}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.tm}}", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}", "--ez", "android.intent.extra.alarm.SKIP_UI", "true"], "timeoutMs": 20000 }
    }
  ]
}
