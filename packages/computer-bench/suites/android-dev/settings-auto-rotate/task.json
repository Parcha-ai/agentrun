{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.settings.auto-rotate",
  "version": 1,
  "title": "Turn auto-rotate on or off in Settings",
  "split": "heldout",
  "tags": ["settings", "toggle", "search"],
  "needs": { "os": "android", "kind": "phone", "apps": ["com.android.settings"] },
  "params": {
    "o": {
      "pick": [
        { "say": "Make the screen rotate automatically when the phone is turned", "want": "1", "start": "0" },
        { "say": "Lock the screen in its current orientation, so it no longer rotates when the phone is turned", "want": "0", "start": "1" },
        { "say": "Turn on auto-rotate screen", "want": "1", "start": "0" },
        { "say": "Turn off auto-rotate screen", "want": "0", "start": "1" }
      ]
    }
  },
  "exec": "deny",
  "setup": [
    {
      "method": "exec.run",
      "why": "Keep the phone's own setting once (a retried setup keeps the first copy), so teardown puts it back.",
      "params": { "argv": ["sh", "-c", "{{file:save.sh}}", "sh", "system accelerometer_rotation"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Start from the other setting, so the agent has to change it.",
      "params": { "argv": ["settings", "put", "system", "accelerometer_rotation", "{{o.start}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open Settings at its home page, whatever screen an earlier run left it on.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.settings.SETTINGS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "Using the Settings app: {{o.say}}.",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "rotation",
      "kind": "exec",
      "why": "Settings' \"Auto-rotate screen\" switch writes system/accelerometer_rotation (1 on, 0 off). Setup left {{o.start}}, so an agent that does nothing fails.",
      "argv": ["settings", "get", "system", "accelerometer_rotation"],
      "stdout": { "equals": "{{o.want}}" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Put the phone's own setting back, and drop the saved copy.",
      "params": { "argv": ["sh", "-c", "{{file:restore.sh}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    {
      "method": "ui.act",
      "why": "Wait for Settings' window: on a fresh phone it shows a moment after am start -W returns.",
      "params": { "target": { "app": "com.android.settings" }, "steps": [], "expect": { "window": { "role": "window" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Search settings" } } } }], "expect": { "text": "Search…" } }
    },
    {
      "method": "ui.act",
      "params": { "foreground": true, "target": { "app": "com.android.settings.intelligence" }, "steps": [{ "type": "rotate", "into": { "find": { "role": "searchbox" } } }], "expect": { "text": "Auto-rotate screen" } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings.intelligence" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Auto-rotate screen" } } } }], "expect": { "text": "Auto-rotate screen" } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings" }, "steps": [], "expect": { "window": { "title": "Display" } } }
    },
    {
      "method": "ui.act",
      "why": "The switch starts the other way, so one press of its row flips it to the goal.",
      "params": { "target": { "app": "com.android.settings" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Auto-rotate screen" } } } }] }
    }
  ]
}
