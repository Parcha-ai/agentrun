{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.contacts.delete-contact",
  "version": 1,
  "title": "Delete one of two similar contacts in Contacts",
  "split": "heldout",
  "tags": ["contacts", "delete", "decoy"],
  "needs": { "os": "android", "kind": "phone", "apps": [["com.google.android.contacts", "com.android.contacts", "com.samsung.android.app.contacts"]] },
  "params": {
    "s": {
      "pick": [
        { "keep": "Lena Brooks", "del": "Liam Brooks", "num": "415 555 0171" },
        { "keep": "Omar Haddad", "del": "Owen Haddad", "num": "415 555 0128" },
        { "keep": "Carla Diaz", "del": "Cody Diaz", "num": "415 555 0164" },
        { "keep": "Jana Novak", "del": "Joel Novak", "num": "415 555 0183" }
      ]
    }
  },
  "exec": "deny",
  "setup": [
    {
      "method": "exec.run",
      "why": "No contact with this run's nonce is left from an earlier try.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Two contacts with the same surname and initial: the one to keep and the one to delete.",
      "params": { "argv": ["sh", "-c", "sh -c \"$1\" sh add computer-bench-{{nonce}}-1 \"$2 {{nonce}}\" '415 555 0110' && sh -c \"$1\" sh add computer-bench-{{nonce}}-2 \"$3 {{nonce}}\" '{{s.num}}'", "sh", "{{file:contacts.sh}}", "{{s.keep}}", "{{s.del}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Open the contacts app on its list, with its permissions granted.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "open"], "timeoutMs": 30000 }
    }
  ],
  "instruction": "In Contacts, delete the contact \"{{s.del}} {{nonce}}\" (number {{s.num}}). Keep \"{{s.keep}} {{nonce}}\".",
  "budget": { "steps": 20, "usd": 1, "wall_s": 240 },
  "checks": [
    {
      "id": "left",
      "kind": "exec",
      "why": "Lists this run's contacts by name: only {{s.keep}} is left. After setup both are listed, so an agent that does nothing fails, and so does one that deleted the wrong contact or both.",
      "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "list", "{{nonce}}"],
      "stdout": { "matches": "^Row: 0 display_name={{s.keep}} {{nonce}}, starred=0\\s*$" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete every contact holding the nonce.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    }
  ],
  "oracle": [
    {
      "method": "ui.act",
      "why": "Wait for the contact list: on a fresh phone it shows a moment after am start -W returns.",
      "params": { "target": { "app": "com.android.contacts" }, "steps": [], "expect": { "text": "{{s.del}} {{nonce}}", "timeoutMs": 10000 } }
    },
    {
      "method": "ui.act",
      "why": "The second row under a letter is named by its contact (the first by the letter), which is why the one to delete sorts after the one to keep.",
      "params": { "target": { "app": "com.android.contacts" }, "foreground": true, "steps": [{ "press": { "find": { "name": { "equals": "{{s.del}} {{nonce}}" } } } }], "expect": { "text": "Add to favorites", "timeoutMs": 8000 } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.contacts" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "More options" } } } }], "expect": { "text": "Delete" } }
    },
    {
      "method": "ui.act",
      "why": "The overflow menu and the confirm dialog are the frontmost windows, so these two acts name no target.",
      "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Delete" } } } }], "expect": { "text": "DELETE" } }
    },
    {
      "method": "ui.act",
      "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "DELETE" } } } }] }
    }
  ]
}
