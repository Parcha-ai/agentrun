{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.contacts.delete-contact",
  "version": 1,
  "title": "Delete one of two similar contacts in Contacts",
  "split": "dev",
  "tags": ["contacts", "delete"],
  "needs": { "os": "android", "kind": "phone", "groups": ["ui", "screen"], "apps": ["com.google.android.contacts", "com.android.contacts", "com.samsung.android.app.contacts"] },
  "params": {
    "who": {
      "pick": [
        { "first": "Lena", "keep": "Marta", "last": "Brandt" },
        { "first": "Diego", "keep": "Pablo", "last": "Ferreira" },
        { "first": "Hana", "keep": "Yuki", "last": "Mori" },
        { "first": "Owen", "keep": "Liam", "last": "Gallagher" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "No contact with this run's nonce is left from an earlier try.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "The contact to delete.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "add", "computer-bench-{{nonce}}-a", "{{who.first}} {{who.last}} {{nonce}}", "202 555 0131"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "A contact with the same last name that must stay, so deleting the wrong one or both fails.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "add", "computer-bench-{{nonce}}-b", "{{who.keep}} {{who.last}} {{nonce}}", "808 555 0173"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Open the contacts app on its list, with its contacts permissions granted.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "open"], "timeoutMs": 30000 }
    }
  ],
  "instruction": "In Contacts, delete the contact \"{{who.first}} {{who.last}} {{nonce}}\". Keep \"{{who.keep}} {{who.last}} {{nonce}}\" and every other contact.",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "deleted-and-kept",
      "kind": "exec",
      "why": "Prints how many contacts show as \"{{who.first}} {{who.last}} {{nonce}}\" and then as \"{{who.keep}} {{who.last}} {{nonce}}\": \"0 1\" is the one deleted and the other kept. After setup it prints \"1 1\", so an agent that does nothing fails; deleting both prints \"0 0\".",
      "argv": ["sh", "-c", "a=$(sh -c \"$1\" sh count \"$2\"); b=$(sh -c \"$1\" sh count \"$3\"); echo \"$a $b\"", "sh", "{{file:contacts.sh}}", "{{who.first}} {{who.last}} {{nonce}}", "{{who.keep}} {{who.last}} {{nonce}}"],
      "stdout": { "equals": "0 1" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete every contact holding the nonce.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "params": { "argv": ["content", "delete", "--uri", "content://com.android.contacts/raw_contacts", "--where", "display_name='{{who.first}} {{who.last}} {{nonce}}'"], "timeoutMs": 30000 }
    }
  ]
}
