{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.contacts.edit-phone",
  "version": 1,
  "title": "Change a contact's phone number in Contacts",
  "split": "heldout",
  "tags": ["contacts", "edit"],
  "needs": { "os": "android", "kind": "phone", "apps": [["com.google.android.contacts", "com.android.contacts", "com.samsung.android.app.contacts"]] },
  "params": {
    "who": {
      "pick": [
        { "first": "Ines", "last": "Carvalho" },
        { "first": "Kofi", "last": "Mensah" },
        { "first": "Priya", "last": "Raman" },
        { "first": "Sven", "last": "Aaberg" }
      ]
    },
    "p": {
      "pick": [
        {
          "old": "650 555 0111", "new": "650 555 0177",
          "old_re": "data1=\\D*(?:1\\D+)?6\\D*5\\D*0\\D*5\\D*5\\D*5\\D*0\\D*1\\D*1\\D*1(?!\\d)",
          "new_re": "data1=\\D*(?:1\\D+)?6\\D*5\\D*0\\D*5\\D*5\\D*5\\D*0\\D*1\\D*7\\D*7(?!\\d)"
        },
        {
          "old": "718 555 0123", "new": "718 555 0145",
          "old_re": "data1=\\D*(?:1\\D+)?7\\D*1\\D*8\\D*5\\D*5\\D*5\\D*0\\D*1\\D*2\\D*3(?!\\d)",
          "new_re": "data1=\\D*(?:1\\D+)?7\\D*1\\D*8\\D*5\\D*5\\D*5\\D*0\\D*1\\D*4\\D*5(?!\\d)"
        },
        {
          "old": "503 555 0160", "new": "971 555 0160",
          "old_re": "data1=\\D*(?:1\\D+)?5\\D*0\\D*3\\D*5\\D*5\\D*5\\D*0\\D*1\\D*6\\D*0(?!\\d)",
          "new_re": "data1=\\D*(?:1\\D+)?9\\D*7\\D*1\\D*5\\D*5\\D*5\\D*0\\D*1\\D*6\\D*0(?!\\d)"
        },
        {
          "old": "206 555 0102", "new": "206 555 0120",
          "old_re": "data1=\\D*(?:1\\D+)?2\\D*0\\D*6\\D*5\\D*5\\D*5\\D*0\\D*1\\D*0\\D*2(?!\\d)",
          "new_re": "data1=\\D*(?:1\\D+)?2\\D*0\\D*6\\D*5\\D*5\\D*5\\D*0\\D*1\\D*2\\D*0(?!\\d)"
        }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "No contact with this run's nonce is left from an earlier try.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "The contact to edit, with the old number.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "add", "computer-bench-{{nonce}}", "{{who.first}} {{who.last}} {{nonce}}", "{{p.old}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Open the contacts app on its list, with its contacts permissions granted.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "open"], "timeoutMs": 30000 }
    }
  ],
  "instruction": "In Contacts, change the phone number of \"{{who.first}} {{who.last}} {{nonce}}\" from {{p.old}} to {{p.new}}, and save.",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 400 },
  "checks": [
    {
      "id": "new-number",
      "kind": "exec",
      "why": "The contact holds {{p.new}}: its digits in order, whatever formatting the Contacts app adds. Setup gave it only {{p.old}}, so an agent that does nothing fails.",
      "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "phones", "{{who.first}} {{who.last}} {{nonce}}"],
      "stdout": { "matches": "{{p.new_re}}" }
    },
    {
      "id": "old-gone",
      "kind": "exec",
      "why": "The contact no longer holds {{p.old}}: the number was changed, not a second one added.",
      "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "phones", "{{who.first}} {{who.last}} {{nonce}}"],
      "stdout": { "matches": "{{p.old_re}}", "not": true }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete every contact holding the nonce.",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "purge", "{{nonce}}"], "timeoutMs": 30000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "params": { "argv": ["sh", "-c", "{{file:contacts.sh}}", "sh", "set-phone", "{{who.first}} {{who.last}} {{nonce}}", "{{p.new}}"], "timeoutMs": 30000 }
    }
  ]
}
