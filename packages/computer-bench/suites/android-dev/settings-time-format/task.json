{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.settings.time-format",
  "version": 1,
  "title": "Switch the clock between 12-hour and 24-hour time in Settings",
  "split": "dev",
  "tags": ["settings", "toggle", "search"],
  "needs": { "os": "android", "kind": "phone", "apps": ["com.android.settings", "com.android.settings.intelligence"] },
  "params": {
    "f": {
      "pick": [
        { "say": "24-hour time (so 5 PM shows as 17:00)", "want": "24", "start": "12" },
        { "say": "12-hour time with AM and PM", "want": "12", "start": "24" },
        { "say": "the 24-hour clock", "want": "24", "start": "12" },
        { "say": "the 12-hour clock (AM/PM)", "want": "12", "start": "24" }
      ]
    }
  },
  "exec": "deny",
  "setup": [
    {
      "method": "exec.run",
      "why": "Keep the phone's own setting once (a retried setup keeps the first copy), so teardown puts it back.",
      "params": { "argv": ["sh", "-c", "f=/data/local/tmp/computer-bench-{{nonce}}.orig; [ -e $f ] || echo \"system time_12_24 $(settings get system time_12_24)\" > $f"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Start from the other format, set explicitly, so the agent has to change it.",
      "params": { "argv": ["settings", "put", "system", "time_12_24", "{{f.start}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open Settings at its home page, whatever screen an earlier run left it on.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.settings.SETTINGS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "Using the Settings app, make the phone show the time in {{f.say}}.",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "format",
      "kind": "exec",
      "why": "Settings' \"Use 24-hour format\" switch writes system/time_12_24 (24 on, 12 off). Setup left {{f.start}}, so an agent that does nothing fails.",
      "argv": ["settings", "get", "system", "time_12_24"],
      "stdout": { "equals": "{{f.want}}" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Put the phone's own setting back (deleted when it had none), and drop the saved copy.",
      "params": { "argv": ["sh", "-c", "{{file:restore.sh}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    {
      "method": "ui.act",
      "why": "Wait for Settings' window: on a fresh phone it shows a moment after am start -W returns.",
      "params": { "target": { "app": "com.android.settings" }, "steps": [], "expect": { "window": { "role": "window" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Search settings" } } } }], "expect": { "text": "Search…" } }
    },
    {
      "method": "ui.act",
      "params": { "foreground": true, "target": { "app": "com.android.settings.intelligence" }, "steps": [{ "type": "24-hour", "into": { "find": { "role": "searchbox" } } }], "expect": { "text": "Use 24-hour format" } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings.intelligence" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Use 24-hour format" } } } }], "expect": { "text": "Use 24-hour format" } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings" }, "steps": [], "expect": { "window": { "title": "Date" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.settings" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Use 24-hour format" } } } }] }
    }
  ]
}
