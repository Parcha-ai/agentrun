{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.chrome.open-article",
  "version": 1,
  "title": "Open a Wikipedia article in Chrome",
  "split": "dev",
  "tags": ["chrome", "navigate", "live-web"],
  "needs": { "os": "android", "kind": "phone", "groups": ["ui", "screen"], "apps": ["com.android.chrome"] },
  "params": {
    "topic": {
      "pick": [
        { "say": "Ada Lovelace", "title": "Ada Lovelace", "slug": "Ada_Lovelace" },
        { "say": "Grace Hopper", "title": "Grace Hopper", "slug": "Grace_Hopper" },
        { "say": "Katherine Johnson, the NASA mathematician", "title": "Katherine Johnson", "slug": "Katherine_Johnson" },
        { "say": "Alan Turing", "title": "Alan Turing", "slug": "Alan_Turing" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "Bring Chrome up on example.com, in the tab the bench reuses (its application id), so the page an earlier run left isn't what shows.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-d", "https://www.example.com/", "-p", "com.android.chrome", "--es", "com.android.browser.application_id", "computer-bench"], "timeoutMs": 30000 }
    }
  ],
  "instruction": "In Chrome, open the English Wikipedia article about {{topic.say}}.",
  "budget": { "steps": 25, "usd": 1, "wall_s": 300 },
  "checks": [
    {
      "id": "heading",
      "kind": "ui",
      "why": "Chrome's page shows a node named exactly \"{{topic.title}}\": the article's title heading. example.com, where setup left Chrome, has none, so an agent that does nothing fails.",
      "app": "com.android.chrome",
      "find": { "name": { "equals": "{{topic.title}}" } }
    },
    {
      "id": "on-wikipedia",
      "kind": "ui",
      "why": "Chrome's address bar (a text field, its text read as the node's value) is on wikipedia.org, so the heading is the article's and not a search result's.",
      "app": "com.android.chrome",
      "find": { "value": { "matches": "wikipedia\\.org" } }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-d", "https://en.wikipedia.org/wiki/{{topic.slug}}", "-p", "com.android.chrome", "--es", "com.android.browser.application_id", "computer-bench"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Give the page time to load before the checks read it.",
      "params": { "argv": ["sleep", "8"], "timeoutMs": 20000 }
    }
  ]
}
