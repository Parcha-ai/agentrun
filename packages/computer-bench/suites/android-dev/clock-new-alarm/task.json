{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.clock.new-alarm",
  "version": 1,
  "title": "Add a labelled alarm that repeats on given days in Clock",
  "split": "dev",
  "tags": ["clock", "alarm", "create", "days", "long"],
  "needs": { "os": "android", "kind": "phone", "apps": [["com.google.android.deskclock", "com.android.deskclock"]] },
  "params": {
    "x": {
      "pick": [
        { "hh": "07", "mm": "15", "find": "7:15" },
        { "hh": "06", "mm": "25", "find": "6:25" },
        { "hh": "05", "mm": "50", "find": "5:50" },
        { "hh": "07", "mm": "40", "find": "7:40" }
      ]
    },
    "s": {
      "pick": [
        { "say": "Monday, Wednesday and Friday", "mon": "on", "wed": "on", "thu": "off", "fri": "on", "sat": "off", "re": "(?:Mon|Wed|Fri)" },
        { "say": "Monday and Thursday", "mon": "on", "wed": "off", "thu": "on", "fri": "off", "sat": "off", "re": "(?:Mon|Thu)" },
        { "say": "Wednesday and Saturday", "mon": "off", "wed": "on", "thu": "off", "fri": "off", "sat": "on", "re": "(?:Wed|Sat)" },
        { "say": "Thursday, Friday and Saturday", "mon": "off", "wed": "off", "thu": "on", "fri": "on", "sat": "on", "re": "(?:Thu|Fri|Sat)" }
      ]
    },
    "n": { "pick": ["Meds", "Standup", "Feed cat", "Bins"] }
  },
  "exec": "deny",
  "setup": [
    {
      "method": "exec.run",
      "why": "Keep the phone's own time format once, so teardown puts it back.",
      "params": { "argv": ["sh", "-c", "{{file:save.sh}}", "sh", "system time_12_24"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "24-hour time, so the time the agent is given ({{x.hh}}:{{x.mm}}) is what the time picker shows, with no AM/PM to choose.",
      "params": { "argv": ["settings", "put", "system", "time_12_24", "24"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "No alarm with this run's label is left from an earlier try.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{n}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the Clock app on its alarm list.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.intent.action.SHOW_ALARMS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Clock app, add a new alarm for {{x.hh}}:{{x.mm}} with the label \"{{n}} {{nonce}}\" that repeats every {{s.say}}, and no other day.",
  "budget": { "steps": 40, "usd": 2, "wall_s": 480 },
  "sufficient": false,
  "checks": [
    {
      "id": "next-ring",
      "kind": "exec",
      "why": "AlarmManager's next alarm clock (the Clock app's soonest enabled alarm), as weekday and time: {{x.hh}}:{{x.mm}} on one of {{s.say}}. The phone's own alarms are off, so an agent that does nothing fails. It can't show the label or the other days: the grader reads the run for those (rubric).",
      "argv": ["sh", "-c", "t=$(dumpsys alarm | grep -A3 'Next alarm clock information' | grep 'user:0 ' | sed 's/.* = \\([0-9-]* [0-9:]*\\)[.].*/\\1/'); [ -n \"$t\" ] && date -d \"$t\" +'%a %H:%M'; true"],
      "stdout": { "matches": "^{{s.re}} {{x.hh}}:{{x.mm}}\\s*$" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Dismiss the alarm by its label (the Clock app switches off a repeating alarm), then by its time for one made with a wrong label.",
      "params": { "argv": ["sh", "-c", "am start -W -a android.intent.action.DISMISS_ALARM --es android.intent.extra.alarm.SEARCH_MODE android.label --es android.intent.extra.alarm.MESSAGE '{{n}} {{nonce}}'; am start -W -a android.intent.action.DISMISS_ALARM --es android.intent.extra.alarm.SEARCH_MODE android.time --ei android.intent.extra.alarm.HOUR {{x.hh}} --ei android.intent.extra.alarm.MINUTES {{x.mm}}"], "timeoutMs": 30000 }
    },
    {
      "method": "exec.run",
      "why": "Put the phone's own time format back, and drop the saved copy.",
      "params": { "argv": ["sh", "-c", "{{file:restore.sh}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    {
      "method": "ui.act",
      "why": "Wait for the Clock's window: on a fresh phone it shows a moment after am start -W returns.",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Add alarm" } } } }], "expect": { "text": "OK" } }
    },
    {
      "method": "ui.act",
      "why": "The time picker opens on its dial; its text mode has an hour and a minute field.",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "press": { "find": { "role": "button", "name": { "contains": "text input mode" } } } }], "expect": { "text": "Type in time" } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "textbox" } }, "value": "{{x.hh}}" }] }
    },
    {
      "method": "ui.act",
      "why": "The minute field is the one still empty.",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "textbox", "value": { "empty": true } } }, "value": "{{x.mm}}" }] }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }] }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [], "expect": { "text": "{{x.find}}" } }
    },
    {
      "method": "ui.act",
      "why": "Expand the new alarm: it is first in the list (before the phone's own 8:30 and 9:00 alarms).",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "press": { "find": { "role": "button", "name": { "contains": "{{x.find}}" } } } }], "expect": { "text": "Repeat" } }
    },
    {
      "method": "ui.act",
      "why": "Checking Repeat checks all seven days. A click here rebinds the alarm's row, so the box a set clicked is gone when its hold is read back; each set's expect (the Clock window, back after the rebind) stands in, the check reads the alarm, and each day is its own act so no ref goes stale.",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "Repeat" } } }, "value": "on" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "why": "Sunday (the first \"S\") is never asked: uncheck it, so Saturday is then the only checked \"S\".",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "S" } } }, "value": "off" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "S" }, "value": { "equals": "checked" } } }, "value": "{{s.sat}}" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "why": "Tuesday (the first \"T\") is never asked: uncheck it, so Thursday is then the only checked \"T\".",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "T" } } }, "value": "off" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "T" }, "value": { "equals": "checked" } } }, "value": "{{s.thu}}" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "M" } } }, "value": "{{s.mon}}" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "W" } } }, "value": "{{s.wed}}" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "set": { "find": { "role": "checkbox", "name": { "equals": "F" } } }, "value": "{{s.fri}}" }], "expect": { "window": { "title": "Clock" } } }
    },
    {
      "method": "ui.act",
      "why": "The label button of a new alarm. It opens a dialog, the frontmost window, so the acts in it name no target.",
      "params": { "target": { "app": "com.android.deskclock" }, "steps": [{ "press": { "find": { "role": "button", "name": { "oneOf": ["Label", "Add label", "Alarm"] } } } }] }
    },
    {
      "method": "ui.act",
      "params": { "steps": [], "expect": { "text": "OK", "timeoutMs": 8000 } }
    },
    {
      "method": "ui.act",
      "params": { "steps": [{ "set": { "find": { "role": "textbox" } }, "value": "{{n}} {{nonce}}" }] }
    },
    {
      "method": "ui.act",
      "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }] }
    }
  ]
}
