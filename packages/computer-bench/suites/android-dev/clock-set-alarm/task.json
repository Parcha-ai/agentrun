{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.clock.set-alarm",
  "version": 2,
  "title": "Set a labelled alarm in Clock",
  "split": "dev",
  "tags": ["clock", "create"],
  "needs": { "os": "android", "kind": "phone", "apps": ["com.google.android.deskclock", "com.android.deskclock", "com.sec.android.app.clockpackage"] },
  "params": {
    "t": {
      "pick": [
        { "say": "6:45 AM", "h": "6", "m": "45", "hh": "06", "mm": "45", "h12": "6", "ap": "AM" },
        { "say": "7:20 AM", "h": "7", "m": "20", "hh": "07", "mm": "20", "h12": "7", "ap": "AM" },
        { "say": "5:55 AM", "h": "5", "m": "55", "hh": "05", "mm": "55", "h12": "5", "ap": "AM" },
        { "say": "8:10 PM", "h": "20", "m": "10", "hh": "20", "mm": "10", "h12": "8", "ap": "PM" }
      ]
    },
    "label": { "pick": ["Run", "Pills", "Call home", "Bins out"] }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "No enabled alarm with this run's label is left from an earlier try (DISMISS_ALARM by label; a no-op when there is none).",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the Clock app on its alarm list, through the intent every clock app answers.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.intent.action.SHOW_ALARMS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Clock app, set an alarm for {{t.say}} with the label \"{{label}} {{nonce}}\".",
  "exec": "deny",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 400 },
  "sufficient": false,
  "checks": [
    {
      "id": "next-alarm",
      "kind": "exec",
      "why": "AlarmManager's next alarm clock (the AlarmClockInfo the Clock app registers for its soonest enabled alarm) rings at {{t.hh}}:{{t.mm}}. Setup leaves no alarm at that time, so an agent that does nothing fails. This assumes the phone has no other enabled alarm ringing sooner (README).",
      "argv": ["sh", "-c", "dumpsys alarm | grep -A3 'Next alarm clock information' | grep 'user:0 '; true"],
      "stdout": { "matches": "time:[1-9]\\d* = \\d{4}-\\d\\d-\\d\\d {{t.hh}}:{{t.mm}}:00" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Dismiss the alarm by its label: the Clock app deletes a one-time alarm made with SKIP_UI and switches off one made by hand, so it rings no more and can't be the next alarm of a later run.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Dismiss by time as well, for an alarm the agent made at the time with a wrong label.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.time", "--ei", "android.intent.extra.alarm.HOUR", "{{t.h}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.m}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    { "method": "ui.act", "why": "Add alarm opens the time picker on its hour dial.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Add alarm" } } } }], "expect": { "text": "CANCEL", "timeoutMs": 8000 } } },
    { "method": "ui.act", "why": "The hour on the dial (a text node; the picker's own hour field is a button). 12 first: the picker opens on the phone's current hour, and a press on the hour already shown changes nothing and can't be confirmed.", "params": { "steps": [{ "press": { "find": { "role": "text", "name": { "equals": "12" } } } }, { "press": { "find": { "role": "text", "name": { "equals": "{{t.h12}}" } } } }], "expect": { "text": "{{t.h12}}", "timeoutMs": 5000 } } },
    { "method": "ui.act", "why": "The minutes field, the picker's two-digit button that is not the one-digit hour, turns the dial to minutes.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "matches": "^(?!{{t.h12}}$)\\d\\d$" } } } }], "expect": { "text": "55", "timeoutMs": 5000 } } },
    { "method": "ui.act", "why": "30 first, for the same reason as the hour (no pick's minute is 30); AM or PM may already be the one asked.", "params": { "steps": [{ "press": { "find": { "role": "text", "name": { "equals": "30" } } } }, { "press": { "find": { "role": "text", "name": { "equals": "{{t.m}}" } } } }, { "press": { "find": { "role": "radio", "name": { "equals": "{{t.ap}}" } } } }], "expect": { "text": "{{t.ap}}", "timeoutMs": 5000 } } },
    { "method": "ui.act", "why": "The new alarm's row is named by its time, which Clock writes with a hair space (U+200A) before AM or PM.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "{{t.h12}}:{{t.mm}} {{t.ap}}", "timeoutMs": 8000 } } },
    { "method": "ui.act", "why": "Open the new alarm's row (its name starts with its time), which shows its Label field.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "matches": "^{{t.h12}}:{{t.mm}}\\s{{t.ap}}\\s" } } } }], "expect": { "text": "Delete", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Label" } } } }], "expect": { "text": "CANCEL", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "set": { "find": { "role": "textbox" } }, "value": "{{label}} {{nonce}}" }], "expect": { "text": "{{label}} {{nonce}}", "timeoutMs": 5000 } } },
    { "method": "ui.act", "why": "Saved: the row's name is now its time and the label.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "OK" } } } }], "expect": { "text": "{{t.h12}}:{{t.mm}} {{t.ap}} {{label}} {{nonce}}", "timeoutMs": 8000 } } }
  ]
}
