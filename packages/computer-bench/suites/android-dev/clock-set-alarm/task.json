{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.clock.set-alarm",
  "version": 1,
  "title": "Set a labelled alarm in Clock",
  "split": "dev",
  "tags": ["clock", "create"],
  "needs": { "os": "android", "kind": "phone", "groups": ["ui", "screen"], "apps": ["com.google.android.deskclock", "com.android.deskclock", "com.sec.android.app.clockpackage"] },
  "params": {
    "t": {
      "pick": [
        { "say": "6:45 AM", "h": "6", "m": "45", "hh": "06", "mm": "45" },
        { "say": "7:20 AM", "h": "7", "m": "20", "hh": "07", "mm": "20" },
        { "say": "5:55 AM", "h": "5", "m": "55", "hh": "05", "mm": "55" },
        { "say": "8:10 PM", "h": "20", "m": "10", "hh": "20", "mm": "10" }
      ]
    },
    "label": { "pick": ["Run", "Pills", "Call home", "Bins out"] }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "No enabled alarm with this run's label is left from an earlier try (DISMISS_ALARM by label; a no-op when there is none).",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the Clock app on its alarm list, through the intent every clock app answers.",
      "params": { "argv": ["am", "start", "-W", "--activity-clear-task", "-a", "android.intent.action.SHOW_ALARMS"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Clock app, set an alarm for {{t.say}} with the label \"{{label}} {{nonce}}\".",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 400 },
  "checks": [
    {
      "id": "next-alarm",
      "kind": "exec",
      "why": "AlarmManager's next alarm clock (the AlarmClockInfo the Clock app registers for its soonest enabled alarm) rings at {{t.hh}}:{{t.mm}}. Setup leaves no alarm at that time, so an agent that does nothing fails. This assumes the phone has no other enabled alarm ringing sooner (README).",
      "argv": ["sh", "-c", "dumpsys alarm | grep -A3 'Next alarm clock information' | grep 'user:0 '; true"],
      "stdout": { "matches": "time:[1-9]\\d* = \\d{4}-\\d\\d-\\d\\d {{t.hh}}:{{t.mm}}:00" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Dismiss the alarm by its label: the Clock app deletes a one-time alarm made with SKIP_UI and switches off one made by hand, so it rings no more and can't be the next alarm of a later run.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.label", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Dismiss by time as well, for an alarm the agent made at the time with a wrong label.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.DISMISS_ALARM", "--es", "android.intent.extra.alarm.SEARCH_MODE", "android.time", "--ei", "android.intent.extra.alarm.HOUR", "{{t.h}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.m}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    {
      "method": "exec.run",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.SET_ALARM", "--ei", "android.intent.extra.alarm.HOUR", "{{t.h}}", "--ei", "android.intent.extra.alarm.MINUTES", "{{t.m}}", "--es", "android.intent.extra.alarm.MESSAGE", "{{label}} {{nonce}}", "--ez", "android.intent.extra.alarm.SKIP_UI", "true"], "timeoutMs": 20000 }
    }
  ]
}
