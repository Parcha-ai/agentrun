{
  "$schema": "../../../schema/task.schema.json",
  "id": "android.files.move-file",
  "version": 2,
  "title": "Move a file into a folder in the Files app",
  "split": "heldout",
  "tags": ["files", "move"],
  "needs": { "os": "android", "kind": "phone", "apps": [["com.google.android.documentsui", "com.android.documentsui", "com.google.android.apps.nbu.files", "com.sec.android.app.myfiles"]] },
  "params": {
    "f": {
      "pick": [
        { "file": "invoice-march", "dest": "Receipts", "other": "Photos" },
        { "file": "lease", "dest": "Housing", "other": "Travel" },
        { "file": "itinerary", "dest": "Travel", "other": "Work" },
        { "file": "payslip-june", "dest": "Work", "other": "Archive" }
      ]
    }
  },
  "setup": [
    {
      "method": "exec.run",
      "why": "A fresh folder for this run in Download: the file to move, a file to leave, the destination folder and a second folder to choose wrongly.",
      "params": { "argv": ["sh", "-c", "d=/sdcard/Download/computer-bench-{{nonce}}; rm -rf $d && mkdir -p $d/{{f.dest}} $d/{{f.other}} && echo 'computer-bench {{nonce}}' > $d/{{f.file}}-{{nonce}}.txt && echo 'stays here' > $d/keep-{{nonce}}.txt"], "timeoutMs": 20000 }
    },
    {
      "method": "exec.run",
      "why": "Open the system file manager (DocumentsUI) on the folder.",
      "params": { "argv": ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-t", "vnd.android.document/directory", "-d", "content://com.android.externalstorage.documents/document/primary%3ADownload%2Fcomputer-bench-{{nonce}}"], "timeoutMs": 20000 }
    }
  ],
  "instruction": "In the Files app, move {{f.file}}-{{nonce}}.txt from Download/computer-bench-{{nonce}} into the folder {{f.dest}} inside it. Leave the other file where it is.",
  "exec": "deny",
  "budget": { "steps": 30, "usd": 1.5, "wall_s": 400 },
  "checks": [
    {
      "id": "files",
      "kind": "exec",
      "why": "Every file under the run's folder, sorted: the moved file in {{f.dest}}, keep-{{nonce}}.txt where it was, and nothing else (no copy left behind, nothing in {{f.other}}). After setup the file is still at the top, so an agent that does nothing fails.",
      "argv": ["sh", "-c", "cd /sdcard/Download/computer-bench-{{nonce}} && find . -type f | sort"],
      "stdout": { "equals": "./{{f.dest}}/{{f.file}}-{{nonce}}.txt\n./keep-{{nonce}}.txt" }
    }
  ],
  "teardown": [
    {
      "method": "exec.run",
      "why": "Delete the run's folder and everything in it.",
      "params": { "argv": ["rm", "-rf", "/sdcard/Download/computer-bench-{{nonce}}"], "timeoutMs": 20000 }
    }
  ],
  "oracle": [
    { "method": "ui.act", "why": "Wait for the folder to list the file.", "params": { "steps": [], "expect": { "text": "{{f.file}}-{{nonce}}.txt", "timeoutMs": 10000 } } },
    { "method": "ui.act", "why": "A long press selects the file.", "params": { "steps": [{ "perform": { "find": { "role": "button", "name": { "equals": "{{f.file}}-{{nonce}}.txt" } } }, "action": "ACTION_LONG_CLICK" }], "expect": { "text": "1 selected", "timeoutMs": 8000 } } },
    { "method": "input.actions", "why": "Tap the selection bar's More options at the screen's top right (336,48 points). A find can't name it: the folder bar's More options, hidden under the selection bar, comes first in the tree.", "params": { "actions": [{ "type": "tap", "at": [672, 96] }] } },
    { "method": "ui.act", "params": { "steps": [], "expect": { "text": "Move to…", "timeoutMs": 5000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Move to…" } } } }], "expect": { "text": "MOVE", "timeoutMs": 8000 } } },
    { "method": "ui.act", "why": "The picker opens on the Downloads root, which lists folders made from the shell but not their subfolders; the phone's own storage root does.", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Show roots" } } } }], "expect": { "text": "redroid15_arm64", "timeoutMs": 8000 } } },
    { "method": "ui.act", "why": "The storage root is named after the phone's model (this cloud phone's image).", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "redroid15_arm64" } } } }], "expect": { "text": "Files on redroid15_arm64", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "Download" } } } }], "expect": { "text": "Files in Download", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "computer-bench-{{nonce}}" } } } }], "expect": { "text": "Files in computer-bench-{{nonce}}", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "{{f.dest}}" } } } }], "expect": { "text": "Files in {{f.dest}}", "timeoutMs": 8000 } } },
    { "method": "ui.act", "params": { "steps": [{ "press": { "find": { "role": "button", "name": { "equals": "MOVE" } } } }], "expect": { "text": "MOVE", "gone": true, "timeoutMs": 8000 } } },
    { "method": "input.actions", "why": "The move runs in the background (\"Moving 1 item\"): give it a moment before the checks read the folder.", "params": { "actions": [{ "type": "wait", "ms": 2000 }] } }
  ]
}
