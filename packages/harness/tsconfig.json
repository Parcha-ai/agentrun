{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "references": [{ "path": "../dsl" }, { "path": "../pi" }, { "path": "../pi-durable-disk/tsconfig.build.json" }, { "path": "../pi-transport/tsconfig.build.json" }, { "path": "../pi-vision" }]
}
