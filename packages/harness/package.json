{
  "name": "@parcha/agentrun-harness",
  "version": "0.1.0-beta.17",
  "description": "The agentrun reference host: one pi-durable host that runs an agentrun job on this machine, with kill-anywhere, a recorder, a supervisor and fakes, so an example runs from an npm install.",
  "keywords": [
    "agentrun",
    "pi",
    "pi-durable",
    "agent",
    "reference",
    "durable"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./scan": {
      "source": "./src/scan.ts",
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js",
      "default": "./dist/scan.js"
    },
    "./child-app": {
      "source": "./src/child-app.ts",
      "types": "./dist/child-app.d.ts",
      "import": "./dist/child-app.js",
      "default": "./dist/child-app.js"
    },
    "./place": {
      "source": "./src/place.ts",
      "types": "./dist/place.d.ts",
      "import": "./dist/place.js",
      "default": "./dist/place.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && for p in dsl jev pi pi-browser pi-durable-disk pi-transport pi-vision; do test -f ../$p/dist/index.d.ts || npm --prefix ../$p run build || exit 1; done && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/chord": ">=1.1.0 <1.4.0",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-codemode": ">=1.1.0 <1.4.0",
    "@earendil-works/pi-durable": ">=1.1.0 <1.4.0",
    "@parcha/pi-transport": "0.1.0-beta.17",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@parcha/pi-transport": {
      "optional": true
    }
  },
  "dependencies": {
    "@parcha/agentrun-dsl": "0.1.0-beta.17",
    "@parcha/agentrun-pi": "0.1.0-beta.17",
    "@parcha/pi-browser": "0.1.0-beta.17",
    "@parcha/pi-durable-disk": "0.1.0-beta.17",
    "@parcha/pi-vision": "0.1.0-beta.17",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@parcha/pi-transport": "0.1.0-beta.17",
    "typebox": "1.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
