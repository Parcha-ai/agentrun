{
  "name": "@parcha/agentrun-import",
  "version": "0.1.0-beta.61",
  "description": "Reads the coding-agent sessions under a home (Claude Code, Codex, pi, OpenCode, GitHub Copilot CLI) into one Session shape, with normalized token usage, subagents under their parent, byte-offset cursors for re-reads, and per-session totals.",
  "keywords": [
    "agentrun",
    "claude-code",
    "codex",
    "copilot",
    "pi",
    "opencode",
    "sessions",
    "usage"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "bin": {
    "agentrun-import": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/import"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
