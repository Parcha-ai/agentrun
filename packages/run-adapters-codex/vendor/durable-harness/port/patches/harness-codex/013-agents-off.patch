Patch: 013-agents-off
Reason: a model Codex's catalog marks multi-agent V2 (luna, sol) was still given V2's collaboration tools and a developer message saying it could spawn sub-agents, since multi_agent = false turns off only V1 and V2 ignores agents.max_depth; agents.enabled = false turns off both versions (autoqa F13's <multi_agent_role> noise)
Upstream: ours
Pins: the config turns code mode's host on, allows no sub-agents, and reserves the agents key
Pins: a code-mode model (luna) is told nothing about a read-only sandbox or sub-agents, and is offered the host's write tool through exec
---
diff --git a/packages/harness-codex/src/config.ts b/packages/harness-codex/src/config.ts
index 6d87a7f..b6d0ebb 100644
--- a/packages/harness-codex/src/config.ts
+++ b/packages/harness-codex/src/config.ts
@@ -29,7 +29,7 @@ export const BUILTINS_OFF: Record<string, boolean> = {
   in_app_browser: false,
   // Code mode's JavaScript runtime (no Node, no file system, no network): the only way a code-mode model such as luna
   // calls a tool. Its nested tools are the dynamic tools plus Codex's own apply_patch and MCP resource readers, which
-  // run nothing here (read-only, approvals declined, no MCP server); its sub-agent tools are removed by agents.max_depth.
+  // run nothing here (read-only, approvals declined, no MCP server); its sub-agent tools are removed by agents.enabled.
   code_mode_host: true,
   tool_suggest: false,
   skill_search: false,
@@ -128,8 +128,9 @@ export function codexConfig(options: CodexConfigOptions): Record<string, TomlVal
     ...(options.cwd ? { projects: { [options.cwd]: { trust_level: 'untrusted' } } } : {}),
     features: { ...BUILTINS_OFF },
     analytics: { enabled: false },
-    // No sub-agents: with code mode's host on, `multi_agent = false` alone still leaves its multi_agent_v1 tools.
-    agents: { max_depth: 0 },
+    // No sub-agents. `multi_agent = false` turns off only V1, and a model Codex's catalog marks V2 (luna, sol) still gets V2's
+    // collaboration tools and a developer message saying it can spawn sub-agents: `enabled = false` turns off both.
+    agents: { enabled: false, max_depth: 0 },
   };
   return merge(base, options.extra ?? {});
 }
