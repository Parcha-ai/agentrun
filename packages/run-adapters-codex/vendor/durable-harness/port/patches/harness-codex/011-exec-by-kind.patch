Patch: 011-exec-by-kind
Reason: only a custom tool call named exec is code mode's exec and gets the custom tool output built from nested calls; a host tool that happens to be named exec is a function call and gets the generic output, so the repair branches on the item kind as well as the name
Upstream: ours
Pins: a host tool named exec is a function call: the repair answers it with the generic output, never as code mode's exec
---
diff --git a/packages/harness-codex/src/harness.ts b/packages/harness-codex/src/harness.ts
index 5608923..8af5953 100644
--- a/packages/harness-codex/src/harness.ts
+++ b/packages/harness-codex/src/harness.ts
@@ -1113,7 +1113,9 @@ export function codexHarness(options: CodexHarnessOptions = {}): Harness {
       const note = recoveryNote(ctx.state());
       if (resume && summary.dangling.length > 0) {
         const ties = (await journal.read<{ callId: string; exec: string | null; since?: number }>(NESTED_STREAM)).map((r) => r.data);
-        const execs = summary.dangling.filter((d) => d.name === 'exec').map((d) => d.callId);
+        // An `exec` is a custom tool call: a host tool that is named "exec" is a function call and gets the generic output.
+        const isExec = (d: { name: string; type: string }) => d.type === 'custom_tool_call' && d.name === 'exec';
+        const execs = summary.dangling.filter(isExec).map((d) => d.callId);
         const rolled = completedNested(lines);
         const factOf = (tie: { callId: string }): NestedFact => {
           const e = ctx.state().effects.get(toolKey(tie.callId));
@@ -1130,7 +1132,7 @@ export function codexHarness(options: CodexHarnessOptions = {}): Harness {
         const listed = recoveryFacts(execs, ties, note ? note.turn.since : Number.NaN, factOf);
         const items = summary.dangling.map((c) => {
           // An `exec` is a custom tool call: its output is one, built from the nested calls the log holds for it, and nothing runs.
-          if (c.name !== 'exec') return { type: 'function_call_output', call_id: c.callId, output: repairOutput(ctx.state(), c) };
+          if (!isExec(c)) return { type: 'function_call_output', call_id: c.callId, output: repairOutput(ctx.state(), c) };
           const { own, loose } = listed.get(c.callId)!;
           // The log's word for a `never` call that completed: the session's record or, when it lost the end, the rollout's (Codex writes
           // that line only after our tool answered, so the effect happened). Each completion answers one re-issue.
diff --git a/packages/harness-codex/src/rollout.ts b/packages/harness-codex/src/rollout.ts
index 6958a36..48d9767 100644
--- a/packages/harness-codex/src/rollout.ts
+++ b/packages/harness-codex/src/rollout.ts
@@ -42,6 +42,8 @@ export interface RolloutLine {
 export interface RolloutCall {
   callId: string;
   name: string;
+  /** `function_call` (a model tool, or a host tool) or `custom_tool_call` (code mode's `exec`). */
+  type: string;
   arguments: string;
   /** Whether a `function_call_output` for it follows. */
   answered: boolean;
@@ -105,7 +107,7 @@ export function summarizeRollout(lines: readonly string[]): RolloutSummary {
       if (typeof id === 'string') threadId = id;
     } else if (line.type === 'response_item') {
       if ((p.type === 'function_call' || p.type === 'custom_tool_call') && typeof p.call_id === 'string') {
-        calls.push({ callId: p.call_id, name: String(p.name ?? ''), arguments: String(p.arguments ?? p.input ?? ''), answered: false, line: i });
+        calls.push({ callId: p.call_id, name: String(p.name ?? ''), type: p.type, arguments: String(p.arguments ?? p.input ?? ''), answered: false, line: i });
       } else if ((p.type === 'function_call_output' || p.type === 'custom_tool_call_output') && typeof p.call_id === 'string') {
         outputs.add(p.call_id);
       }
