+          const unplaced = (t: { exec: string | null; since?: number }) => note !== undefined && t.exec === null && t.since === note.turn.since;
+          for (const tie of ties.filter((t) => t.exec === c.callId || (unplaced(t) && c.callId === lastExec && dangling.length === 1))) {
