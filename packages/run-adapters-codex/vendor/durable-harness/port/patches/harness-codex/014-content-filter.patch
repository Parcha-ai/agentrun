Patch: 014-content-filter
Reason: a provider that stops an answer on its content filter (an OpenAI response incomplete for content_filter) has Codex treat it as a stream error and ask for the refused answer again; the session's model proxy reads the stop in the answer it passes and says it once (onFiltered, with the kernel's CONTENT_FILTERED), and the harness halts the turn, failed in those words
Upstream: ours
Pins: a provider's content-filter stop ends a codex turn at once: one request, failed with the content-filter text
---
diff --git a/packages/harness-codex/src/harness.ts b/packages/harness-codex/src/harness.ts
index f3ab557..40f4e01 100644
--- a/packages/harness-codex/src/harness.ts
+++ b/packages/harness-codex/src/harness.ts
@@ -443,6 +443,9 @@ export function codexHarness(options: CodexHarnessOptions = {}): Harness {
       onCap: (cap) => {
         if (cap !== 'concurrency') capped = cap;
       },
+      // A provider's content filter stopping an answer fails the turn at once, in the model proxy's words, so Codex
+      // never asks for the refused answer again.
+      onFiltered: (message) => ctx.halt?.(new Error(message)),
       // Without the app's own log, the handler's default: a refused model call is a warning in the Function's logs, not silence.
       ...(options.log ? { log: (message: string, fields?: Record<string, unknown>) => log(`codex gateway: ${message}`, fields) } : {}),
     });
