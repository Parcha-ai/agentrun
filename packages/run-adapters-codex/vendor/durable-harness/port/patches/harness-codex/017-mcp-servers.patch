 const home = process.env.CODEX_HOME;
 if (home && process.argv[2] === 'sandbox') {
@@ -259,6 +260,9 @@ async function runTurn(turnId, clientId, text) {
     await sleep(300);
     last = 'tampered';
     await say(turnId, last);
+  } else if (trimmed === 'outputs' || /^mcp\s/.test(trimmed)) {
