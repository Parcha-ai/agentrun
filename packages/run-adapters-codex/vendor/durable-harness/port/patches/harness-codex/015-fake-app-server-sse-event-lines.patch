Patch: 015-fake-app-server-sse-event-lines
Reason: the stand-in's remote model read each SSE event as one `data:` line, so a stream that names each event on an `event:` line before its data, as the Responses API sends it, failed to parse at its first event
Upstream: ours
Pins: a long answer whose final event is longer than the model proxy keeps of it (encrypted reasoning past 64 KiB), the stop early in it: the turn still ends at once, after one request
---
diff --git a/packages/harness-codex/test/fake-app-server.mjs b/packages/harness-codex/test/fake-app-server.mjs
index ab58519..1370037 100644
--- a/packages/harness-codex/test/fake-app-server.mjs
+++ b/packages/harness-codex/test/fake-app-server.mjs
@@ -186,7 +186,8 @@ async function stream(text, onPiece) {
   for await (const chunk of res.body) {
     buffer += decoder.decode(chunk, { stream: true });
     for (let at = buffer.indexOf('\n\n'); at >= 0; at = buffer.indexOf('\n\n')) {
-      const data = buffer.slice(0, at).replace(/^data: /, '');
+      // An event's `data:` lines (the provider names each event on an `event:` line before them).
+      const data = buffer.slice(0, at).split('\n').filter((line) => line.startsWith('data:')).map((line) => line.replace(/^data: ?/, '')).join('\n');
       buffer = buffer.slice(at + 2);
       if (data === '[DONE]') return;
       if (data) onPiece(JSON.parse(data).delta);
