{
  "name": "@parcha/agentrun-codex",
  "version": "0.1.0-beta.27",
  "private": true,
  "description": "Codex as an AgentRun harness: a tool-less Codex app-server behind a loopback model proxy, durable in AgentRun's own store, with the host's tools as its only tools.",
  "keywords": [
    "agentrun",
    "agent",
    "harness",
    "codex",
    "durable"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "vendor/durable-harness/UPSTREAM.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=8 'test/*.test.mjs'"
  },
  "dependencies": {
    "@parcha/agentrun-adapters": "0.1.0-beta.27",
    "@parcha/agentrun-dsl": "0.1.0-beta.27"
  },
  "peerDependencies": {
    "@openai/codex": "0.164.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/codex": "0.164.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/run-adapters-codex"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
