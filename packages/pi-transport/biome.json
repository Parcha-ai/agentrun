{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"root": true,
	"files": {
		"includes": ["src/**", "test/**", "examples/**", "vitest.config.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useConst": "error",
				"noNonNullAssertion": "off"
			}
		}
	}
}
