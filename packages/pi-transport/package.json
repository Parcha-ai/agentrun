{
  "name": "@parcha/pi-transport",
  "version": "0.1.0-beta.12",
  "private": true,
  "description": "Run a pi-durable session's tools in another machine, or move the session there: one small box interface, providers for this machine and Docker, and a conformance suite a vendor can run.",
  "keywords": [
    "pi",
    "pi-durable",
    "sandbox",
    "docker",
    "execution-environment",
    "agent"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Parcha Labs, Inc.",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./box/local": {
      "source": "./src/box/local.ts",
      "types": "./dist/box/local.d.ts",
      "import": "./dist/box/local.js",
      "default": "./dist/box/local.js"
    },
    "./box/docker": {
      "source": "./src/box/docker.ts",
      "types": "./dist/box/docker.d.ts",
      "import": "./dist/box/docker.js",
      "default": "./dist/box/docker.js"
    },
    "./box/modal": {
      "source": "./src/box/modal.ts",
      "types": "./dist/box/modal.d.ts",
      "import": "./dist/box/modal.js",
      "default": "./dist/box/modal.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest --run",
    "test:live:docker": "PI_TRANSPORT_LIVE_DOCKER=1 vitest --run test/box-docker.live.test.ts",
    "test:live:modal": "PI_TRANSPORT_LIVE_MODAL=1 vitest --run test/box-modal.live.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/chord": ">=1.0.4 <1.2.0",
    "@earendil-works/pi-durable": ">=1.0.4 <1.2.0"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "modal": "0.11.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parcha-ai/agentrun.git",
    "directory": "packages/pi-transport"
  },
  "bugs": {
    "url": "https://github.com/Parcha-ai/agentrun/issues"
  },
  "homepage": "https://agentrun.ai",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
