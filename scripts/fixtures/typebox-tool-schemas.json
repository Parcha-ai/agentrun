{
 "pi": {
  "type": "object",
  "required": [
   "action"
  ],
  "properties": {
   "action": {
    "anyOf": [
     {
      "type": "string",
      "const": "describe"
     },
     {
      "type": "string",
      "const": "inspect"
     },
     {
      "type": "string",
      "const": "dry-run"
     },
     {
      "type": "string",
      "const": "run"
     },
     {
      "type": "string",
      "const": "save"
     },
     {
      "type": "string",
      "const": "load"
     },
     {
      "type": "string",
      "const": "list"
     }
    ]
   },
   "name": {
    "type": "string",
    "description": "Saved procedure name: lowercase letters, digits, hyphens or underscores."
   },
   "digest": {
    "type": "string",
    "description": "Optional exact saved SHA-256 revision to load."
   },
   "workflow": {
    "type": "object",
    "patternProperties": {
     "^.*$": {}
    },
    "description": "The complete AgentRun workflow JSON object. Pass the object directly, not a JSON-encoded string. Inspection validates its DSL structure."
   },
   "input": {
    "type": "object",
    "patternProperties": {
     "^.*$": {}
    }
   }
  }
 }
}