{
  "package": "@parcha/agentrun-serve",
  "install": [
    "dsl",
    "jev",
    "pi-browser",
    "decisions",
    "run-adapters",
    "run-adapters-claude-agent",
    "run-adapters-codex",
    "computer",
    "serve"
  ],
  "companions": [
    "@parcha/agentrun-dsl",
    "@parcha/agentrun-jev",
    "@parcha/pi-browser",
    "@parcha/agentrun-decisions",
    "@parcha/agentrun-kernel",
    "@parcha/agentrun-harness-claude",
    "@parcha/agentrun-harness-codex",
    "@parcha/agentrun-computer"
  ],
  "peers": [
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "@earendil-works/pi-ai"
  ],
  "files": [
    {
      "name": "check.mjs",
      "readme": "docs/releasing.md",
      "heading": "Check a published server",
      "fence": "js",
      "index": 0
    }
  ],
  "command": [
    "node",
    "check.mjs"
  ],
  "expect": {
    "exitCode": 0,
    "pattern": "^ok: pi runs; claude-agent and codex install on first use; the console is served$"
  },
  "timeoutMs": 300000
}
