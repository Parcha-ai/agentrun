{
  "package": "@parcha/pi-durable-disk",
  "install": [
    "pi-durable-disk"
  ],
  "peers": [
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "@earendil-works/pi-ai"
  ],
  "files": [
    {
      "name": "chat.mjs",
      "readme": "packages/pi-durable-disk/README.md",
      "heading": "Quickstart on one machine: no disk, no key",
      "fence": "js",
      "index": 0
    }
  ],
  "readmeInstall": {
    "readme": "packages/pi-durable-disk/README.md",
    "heading": "Quickstart on one machine: no disk, no key",
    "fence": "sh",
    "index": 0
  },
  "command": [
    "node",
    "chat.mjs"
  ],
  "expect": {
    "exitCode": 0,
    "pattern": "^ok: 6 messages answered once each, by generations 1 and 2, from the store in "
  },
  "timeoutMs": 120000,
  "examples": {
    "readme": "packages/pi-durable-disk/examples/README.md",
    "heading": "Run one from an install",
    "fence": "sh",
    "index": 0,
    "dir": "packages/pi-durable-disk/examples",
    "timeoutMs": 120000,
    "platformFloors": {
      "darwin": "0.1.0-beta.14"
    }
  }
}
