{
  "package": "@parcha/pi-durable-disk",
  "install": [
    "pi-durable-disk"
  ],
  "peers": [
    "@earendil-works/chord",
    "@earendil-works/pi-durable",
    "@earendil-works/pi-ai"
  ],
  "files": [
    {
      "name": "pick-up.mts",
      "readme": "packages/pi-durable-disk/README.md",
      "heading": "Try it: no disk, no key",
      "fence": "ts",
      "index": 0
    }
  ],
  "readmeInstall": {
    "readme": "packages/pi-durable-disk/README.md",
    "heading": "Try it: no disk, no key",
    "fence": "sh",
    "index": 0
  },
  "command": [
    "node",
    "pick-up.mts"
  ],
  "expect": {
    "exitCode": 0,
    "pattern": "^ok: three processes, one run: each picked up where the last released it, the last still knew the first question, and the run reads done at generation 3 \\("
  },
  "timeoutMs": 120000,
  "examples": {
    "readme": "packages/pi-durable-disk/examples/README.md",
    "heading": "Run one from an install",
    "fence": "sh",
    "index": 0,
    "dir": "packages/pi-durable-disk/examples",
    "timeoutMs": 120000,
    "platformFloors": {
      "darwin": "0.1.0-beta.14"
    }
  }
}
